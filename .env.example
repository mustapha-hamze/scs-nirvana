OPENAI_API_KEY=

# Referenced by the Google auth package in Web.csproj, but Google login is not
# currently wired up in Program.cs/AccountController.cs (no ClientId/ClientSecret
# exist anywhere in the codebase yet). Set these once that's implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reverse-proxy forwarded-header support (ReverseProxyOptions), disabled by default. Only enable
# this behind a real reverse proxy/load balancer that sets X-Forwarded-For/X-Forwarded-Proto -
# ReverseProxy__KnownProxies and/or ReverseProxy__KnownNetworks must then list every proxy that is
# allowed to set those headers, or the app fails to start (see ReverseProxyOptionsValidator).
ReverseProxy__Enabled=false
# Comma-separated IP addresses, e.g. 10.0.0.5,10.0.0.6
ReverseProxy__KnownProxies=
# Comma-separated CIDR networks, e.g. 10.0.0.0/24
ReverseProxy__KnownNetworks=
# Number of proxy hops to trust; keep this at the actual hop count between the app and the edge.
ReverseProxy__ForwardLimit=1
