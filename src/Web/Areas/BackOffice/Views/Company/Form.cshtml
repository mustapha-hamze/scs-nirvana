@{
    Layout = null;
    var zones = (List<Infrastructure.Dto.GeneralDtos.ZoneDto>)ViewData["Zones"];

    var accesses = await userManagementServices.GetUserAccesses(User.Identity.Name);
    if (accesses == string.Empty)
        accesses = "NULL";
}

@inject Services.UserManagementServices.IUserManagementServices userManagementServices

@model Infrastructure.Dto.PropTechDtos.CompanyDto

<form class="needs-validation row" novalidate id="frmCompany" method="POST">
    <input type="hidden" asp-for="Id" id="Id" />
    <input type="hidden" asp-for="ApplicationId" id="ApplicationId" />
    <input type="hidden" asp-for="IsActive" id="IsActive" />
    <input type="hidden" asp-for="IsDeleted" id="IsDeleted" />
    <input type="hidden" asp-for="Status" id="Status" />
    <input type="hidden" asp-for="CreatedDT" id="CreatedDT" />
    <input type="hidden" asp-for="UpdatedDT" id="UpdatedDT" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="Type">Type</label>
        <select class="form-control" asp-for="Type" required>
            <option value="2004">Developer</option>
            <option value="2005">Sales Office</option>
        </select>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" placeholder="Title" required minlength="4"
            maxlength="64">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="CityId">City</label>
        <select asp-for="CityId" class="form-control select2" data-toggle="select2" data-placeholder="Choose ..."
            id="__Select2_Cities__">
            @if (zones != null)
            {
                foreach (var item in zones)
                {
                    <option value="@item.Id">@item.Title</option>
                }
            }
        </select>
    </div>
    <div class="col-md-12 mb-2">
        <label class="form-label" asp-for="Description">Description</label>
        <textarea class="form-control" asp-for="Description"></textarea>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="PhoneOne">Phone One</label>
        <input type="text" class="form-control" asp-for="PhoneOne" placeholder="Phone One" minlength="9" maxlength="16"
            oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');">
        <div class="invalid-feedback">
            Min length is 9 and max length is 16
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="PhoneTwo">Phone Two</label>
        <input type="text" class="form-control" asp-for="PhoneTwo" placeholder="Phone Two" minlength="9" maxlength="16"
            oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');">
        <div class="invalid-feedback">
            Min length is 9 and max length is 16
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="Email">Email</label>
        <input type="email" class="form-control" asp-for="Email" placeholder="Email" maxlength="128">
        <div class="invalid-feedback">
            Miax length is 128
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="Website">Website URL</label>
        <input type="text" class="form-control" asp-for="Website" placeholder="Website" maxlength="128">
        <div class="invalid-feedback">
            Miax length is 128
        </div>
    </div>
    <div class="col-md-12 mb-2">
        <label class="form-label" asp-for="Address">Address</label>
        <input type="text" class="form-control" asp-for="Address" placeholder="Address" maxlength="256">
        <div class="invalid-feedback">
            Max length is 256
        </div>
    </div>
    <div class="col-md-12 mb-1 mt-3">
        <p class="alert alert-info">Note: POI is a person in charge in this company</p>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="POIFullName">POI Full Name</label>
        <input type="text" class="form-control" asp-for="POIFullName" placeholder="POI Full Name" maxlength="64"
            minlength="4">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="POIMobile">POI Mobile</label>
        <input type="text" class="form-control" asp-for="POIMobile" placeholder="POI Mobile" minlength="9"
            maxlength="16" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');">
        <div class="invalid-feedback">
            Min length is 9 and max length is 16
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="POIPhone">POI Phone</label>
        <input type="text" class="form-control" asp-for="POIPhone" placeholder="POI Phone" minlength="9" maxlength="16"
            oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');">
        <div class="invalid-feedback">
            Min length is 9 and max length is 16
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="POIEmail">POI Email</label>
        <input type="email" class="form-control" asp-for="POIEmail" placeholder="POI Email" maxlength="128">
        <div class="invalid-feedback">
            Miax length is 128
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="POIPosition">POI Position</label>
        <input type="text" class="form-control" asp-for="POIPosition" placeholder="POI Position" maxlength="64"
            minlength="4">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
    <div class="col-md-12 mb-2">
        <label class="form-label" asp-for="POIDescription">POI Description</label>
        <textarea class="form-control" asp-for="POIDescription"></textarea>
    </div>
    @if (User.IsInRole("SuperAdmin") || accesses.Contains("PTE2000_1003_SAVE_1003"))
    {
        <div class="mb-3 col-md-12">
            <a href="javascript: void(0);" id="btnSaveCompanyForm" class="btn btn-primary mt-2"
                onclick="SaveCompanyForm()"><i class="uil uil-file-check-alt"></i> Save Company</a>
        </div>
    }
</form>