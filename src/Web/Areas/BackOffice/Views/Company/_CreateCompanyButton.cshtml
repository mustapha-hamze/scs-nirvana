@{
    Layout = null;

    var accesses = await userManagementServices.GetUserAccesses(User.Identity.Name);
    if (accesses == string.Empty)
        accesses = "NULL";
}

@inject Services.UserManagementServices.IUserManagementServices userManagementServices

@if (User.IsInRole("SuperAdmin") || accesses.Contains("PTE2000_1003_ADD_1000"))
{
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#company-modal"
    onclick="companyForm()">
    <i class="uil uil-plus"></i>
    Add Company
</button>
}