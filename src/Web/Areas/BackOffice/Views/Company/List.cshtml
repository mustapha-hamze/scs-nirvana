@{
    Layout = null;

    var accesses = await userManagementServices.GetUserAccesses(User.Identity.Name);
    if (accesses == string.Empty)
        accesses = "NULL";
}

@inject Services.UserManagementServices.IUserManagementServices userManagementServices

@model List<Infrastructure.Dto.PropTechDtos.CompanyDto>

<table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">
    <thead>
        <th>Id</th>
        <th>Type</th>
        <th>Title</th>
        <th>Email</th>
        <th>Phone</th>
        <th>POI Full Name</th>
        <th>POI Mobile</th>
        <th>Activity</th>
        <th>Created</th>
        <th>Manage</th>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>
                    @switch (item.Type)
                    {
                        case 2004:
                            <text>Developer</text>
                            break;
                        case 2005:
                            <text>Sales Office</text>
                            break;
                    }
                </td>
                <td>
                    @item.Title
                </td>
                <td>
                    @item.Email
                </td>
                <td>
                    @item.PhoneOne
                </td>
                <td>
                    @item.POIFullName
                </td>
                <td>
                    @item.POIMobile
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success rounded-pill p-1">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger rounded-pill p-1">Deactive</span>
                    }
                </td>
                <td>
                    @item.CreatedDT.ToString("yyyy MMM dd")
                </td>
                <td>
                    @if (User.IsInRole("SuperAdmin") || accesses.Contains("PTE2000_1003_EDIT_1005"))
                    {
                        <a href="javascript: void(0);" class="action-icon" onclick="companyForm(@item.Id)"
                            data-bs-toggle="modal" data-bs-target="#company-modal">
                            <i class="mdi mdi-content-save-edit"></i>
                        </a>
                    }
                    @if (User.IsInRole("SuperAdmin") || accesses.Contains("PTE2000_1003_DELETE_1002"))
                    {
                        <a href="javascript: void(0);" class="action-icon" onclick="deleteCompany(@item.Id)">
                            <i class="mdi mdi-delete"></i>
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>