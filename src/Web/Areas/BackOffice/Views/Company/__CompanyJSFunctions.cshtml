@{
    Layout = null;
}

<script>
    function companyForm(id = 0) {
        clearModalBody("companyModalBody");
        $.ajax({
            url: '/BackOffice/Company/Form/' + id,
            type: "GET"
        }).done(function (data) {
            $("#companyModalBody").html(data);
            $('#__Select2_Cities__').select2({
                dropdownParent: $('#company-modal')
            });
        });
    }

    function SaveCompanyForm() {
        if (checkFormValidity('frmCompany')) {
            var frmCompany = $("#frmCompany");
            clearModalBody("companyModalBody");
            $.ajax({
                url: '/BackOffice/Company/SaveForm',
                type: "POST",
                data: frmCompany.serialize()
            }).done(function (data) {
                if (data === "Done") {
                    messageBox("Saved!", "Content metadata has been saved", "success");
                    findCompanies();
                    $('#company-modal').modal('hide');
                }
                else {
                    messageBox("error!", "Content metadata has not been saved", "error");
                }
            });
        }
    }

    function findCompanies() {
        clearModalBody("findCompaniesResultBody");
        $.ajax({
            url: '/BackOffice/Company/List',
            type: "GET"
        }).done(function (data) {
            $("#findCompaniesResultBody").html(data);
            $("#datatable-buttons").DataTable({
                lengthChange: !1,
                pageLength: 25,
                buttons: ["copy", "print"],
                language: {
                    paginate: {
                        previous: "<i class='mdi mdi-chevron-left'>",
                        next: "<i class='mdi mdi-chevron-right'>"
                    }
                },
                drawCallback: function () {
                    $(".dataTables_paginate > .pagination").addClass("pagination-rounded")
                }
            });
        });
    }

    function deleteCompany(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/BackOffice/Company/Delete/' + id,
                    type: "GET"
                }).done(function (data) {
                    if (data === "Done") {
                        messageBox("Deleted!", "Selected item has been deleted.", "success");
                        findCompanies();
                    } else {
                        messageBox("Error!", "Selected item has not been deleted.", "error");
                    }
                });
            }
        });
    }
</script>