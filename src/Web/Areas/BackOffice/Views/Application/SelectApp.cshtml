@model List<Application.Contracts.General.ApplicationDto>

@{
    Layout = null;
    var userApplications =
    (List<Application.Contracts.General.UserInApplicationDto>)ViewData["UserApplications"];

    // A SuperAdmin may select any active, non-deleted application without needing a membership
    // row of their own - see ApplicationController.SelectAppToEnter and
    // ITenantAccessGuard.HasAccessAsync for the matching selection-time/request-time
    // authorization. An ordinary user's choices stay exactly as before: driven entirely by their
    // own active memberships (userApplications), never the full application list.
    var applicationsToShow = User.IsInRole("SuperAdmin")
        ? Model.Where(a => a.IsActive).ToList()
        : userApplications
            .Select(item => Model.SingleOrDefault(a => a.Id == item.ApplicationId))
            .Where(app => app != null)
            .ToList();

    // Size the grid to the real number of cards so one or two cards never sit beside empty columns.
    var cardCount = applicationsToShow.Count + (User.IsInRole("SuperAdmin") ? 1 : 0);
    var (pickerColClass, pickerRowClass) = cardCount switch
    {
        1 => ("col-sm-8 col-md-6 col-lg-4", "row-cols-1"),
        2 => ("col-lg-8 col-xl-7", "row-cols-1 row-cols-md-2"),
        _ => ("col-xl-10 col-lg-11", "row-cols-1 row-cols-md-2 row-cols-xl-3")
    };
}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Select a workspace - Nirvana CMS</title>

    @await Html.PartialAsync("_CSSAssets")

</head>

<body class="loading authentication-bg"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":true, "showRightSidebarOnStart": true}'>
    <main class="account-pages pt-4 pt-sm-5 pb-4 pb-sm-5 scs-app-picker">
        <div class="container">
            <div class="row justify-content-center">
                <div class="@pickerColClass">

                    <header class="text-center mb-4 scs-app-picker-header">
                        <div class="d-inline-flex align-items-center gap-2 mb-3">
                            <span class="scs-auth-mark" aria-hidden="true">N</span>
                            <span class="scs-app-picker-brand">Nirvana CMS</span>
                        </div>
                        <h1>Select a workspace</h1>
                        <p class="scs-app-picker-lead mb-0">Choose the application whose content you want to manage.</p>
                    </header>

                    @* For a normal user, selection is always driven by their own
                       memberships (userApplications) - never the full application
                       list - so this page never implies access to an application
                       they aren't actually a member of. A SuperAdmin instead sees
                       every active, non-deleted application (applicationsToShow,
                       computed above). *@
                    @if (applicationsToShow.Count == 0 && !User.IsInRole("SuperAdmin"))
                    {
                        <div class="card scs-app-picker-empty">
                            <div class="card-body text-center p-4 p-lg-5">
                                <i class="uil uil-apps scs-app-picker-empty-icon" aria-hidden="true"></i>
                                <h2 class="h4 mt-3">No workspaces available yet</h2>
                                <p class="text-muted mb-4">Your account isn't a member of any active application.
                                    Ask an administrator to grant you access, then sign in again.</p>
                                <form method="post" action="/Logout" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-light">
                                        <i class="mdi mdi-logout me-1" aria-hidden="true"></i> Sign out
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ul class="row @pickerRowClass g-3 justify-content-center list-unstyled mb-0" aria-label="Workspaces">
                            @foreach (var app in applicationsToShow)
                            {
                                <li class="col">
                                    <article class="card h-100 mb-0 scs-application-card">
                                        <div class="scs-application-logo-wrap">
                                            @if (string.IsNullOrEmpty(app.LogoFileName))
                                            {
                                                <span class="scs-application-initial" aria-hidden="true">@(app.Title?.Substring(0, 1).ToUpperInvariant())</span>
                                            }
                                            else
                                            {
                                                <img src="/Storage/Application/Logos/@app.LogoFileName" alt="@app.Title logo" />
                                            }
                                        </div>
                                        <div class="card-body d-flex flex-column">
                                            <h2 class="h5 card-title mb-1 text-truncate" title="@app.Title">@app.Title</h2>
                                            <p class="card-text scs-application-description">@app.Description</p>
                                            <form method="post" action="/BackOffice/Application/SelectAppToEnter/@app.Id" class="mt-auto scs-app-picker-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-primary w-100" aria-label="Open @app.Title">
                                                    Open workspace <i class="uil uil-arrow-right ms-1" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </article>
                                </li>
                            }
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="col">
                                    <button type="button" class="card h-100 mb-0 w-100 scs-add-workspace" data-bs-toggle="modal"
                                        data-bs-target="#application-modal" onclick="newApplicationForm()">
                                        <span class="scs-add-workspace-icon" aria-hidden="true"><i class="uil uil-plus"></i></span>
                                        <span class="fw-semibold">Add workspace</span>
                                        <span class="scs-add-workspace-hint">Create a new application</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                </div> <!-- end col -->
            </div>
            <!-- end row -->
        </div>
        <!-- end container -->
    </main>
    <!-- end page -->

    <footer class="footer footer-alt">
        Nirvana CMS &middot; Sonic Core System
    </footer>

    <!-- bundle -->
    @await Html.PartialAsync("_JSAssets")

    @await Html.PartialAsync("__ApplicationModal")
    @await Html.PartialAsync("__ApplicationJSFunctions")

    <script>
        // Loading feedback: lock every workspace button once one is chosen so it can't be double-submitted.
        document.querySelectorAll(".scs-app-picker-form").forEach(function (form) {
            form.addEventListener("submit", function () {
                document.querySelectorAll(".scs-app-picker-form button").forEach(function (btn) { btn.disabled = true; });
                form.querySelector("button").innerHTML =
                    '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Opening...';
            });
        });
    </script>
</body>

</html>
