@model List<Application.Contracts.General.ApplicationDto>

@{
    Layout = null;
    var userApplications =
    (List<Application.Contracts.General.UserInApplicationDto>)ViewData["UserApplications"];

    // A SuperAdmin may select any active, non-deleted application without needing a membership
    // row of their own - see ApplicationController.SelectAppToEnter and
    // ITenantAccessGuard.HasAccessAsync for the matching selection-time/request-time
    // authorization. An ordinary user's choices stay exactly as before: driven entirely by their
    // own active memberships (userApplications), never the full application list.
    var applicationsToShow = User.IsInRole("SuperAdmin")
        ? Model.Where(a => a.IsActive).ToList()
        : userApplications
            .Select(item => Model.SingleOrDefault(a => a.Id == item.ApplicationId))
            .Where(app => app != null)
            .ToList();
}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Select Application to login | SCS</title>

    <!-- App favicon -->
    <link rel="shortcut icon" href="/BackOffice/images/favicon.ico">

    @await Html.PartialAsync("_CSSAssets")

</head>

<body class="loading authentication-bg"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":true, "showRightSidebarOnStart": true}'>
    <div class="account-pages pt-4 pt-sm-5 pb-4 pb-sm-5 scs-app-picker">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-10 col-lg-11">
                    <div class="card scs-app-picker-card">

                        <!-- Logo -->
                        <div class="card-header text-center scs-app-picker-header">
                            <span class="scs-auth-mark mb-2">N</span>
                            <h1>Select a workspace</h1>
                            <p>Choose the application you want to manage.</p>
                        </div>

                        <div class="card-body p-3 p-lg-4">
                            <div class="row g-3">
                                @* For a normal user, selection is always driven by their own
                                   memberships (userApplications) - never the full application
                                   list - so this page never implies access to an application
                                   they aren't actually a member of. A SuperAdmin instead sees
                                   every active, non-deleted application (applicationsToShow,
                                   computed above). *@
                                @foreach (var app in applicationsToShow)
                                {
                                    <div class="col-md-6 col-xl-4">
                                        <div class="card d-block h-100 scs-application-card">
                                            <div class="scs-application-logo-wrap">
                                                <img class="card-img-top" src="/Storage/Application/Logos/@app.LogoFileName" alt="@app.Title logo" />
                                            </div>
                                            <div class="card-body">
                                                <h5 class="card-title">@app.Title</h5>
                                                <p class="card-text scs-application-description">@app.Description</p>
                                                <form method="post" action="/BackOffice/Application/SelectAppToEnter/@app.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-primary w-100">Select</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <div class="col-md-6 col-xl-4">
                                        <button class="btn btn-outline-primary h-100 w-100 scs-add-workspace" data-bs-toggle="modal"
                                            data-bs-target="#application-modal" onclick="newApplicationForm()">
                                            <i class="uil uil-plus"></i>
                                            <span>New application</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                    <!-- end card -->

                </div> <!-- end col -->
            </div>
            <!-- end row -->
        </div>
        <!-- end container -->
    </div>
    <!-- end page -->

    <footer class="footer footer-alt">
        <script>document.write(new Date().getFullYear())</script> © SCS
    </footer>

    <!-- bundle -->
    @await Html.PartialAsync("_JSAssets")

    @await Html.PartialAsync("__ApplicationModal")
    @await Html.PartialAsync("__ApplicationJSFunctions")
</body>

</html>
