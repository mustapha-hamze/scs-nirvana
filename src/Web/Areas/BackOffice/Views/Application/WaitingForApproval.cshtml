@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Waiting for approval - Nirvana CMS</title>
    @await Html.PartialAsync("_CSSAssets")
</head>

<body class="authentication-bg">

    <main class="scs-auth-page">
        <div class="container">
            <div class="card scs-auth-card">
                <div class="card-body">

                    <a class="scs-auth-brand" href="/">
                        <span class="scs-auth-mark" aria-hidden="true">N</span>
                        <span class="scs-app-picker-brand">Nirvana CMS</span>
                    </a>

                    <span class="scs-auth-status scs-auth-status--warning" aria-hidden="true"><i class="uil uil-clock"></i></span>
                    <h1 class="scs-auth-title">Your account is waiting for approval</h1>
                    <p class="scs-auth-lead">You're signed in, but an administrator still needs to approve your account
                        before you can open a workspace.</p>

                    <ol class="scs-auth-steps">
                        <li>Ask a Nirvana CMS administrator to approve your account.</li>
                        <li>Once approved, choose <strong>Check again</strong> to continue to your workspaces.</li>
                    </ol>

                    <div class="scs-auth-actions">
                        <a class="btn btn-primary" href="/BackOffice/Application/SelectApp">
                            <i class="uil uil-redo me-1" aria-hidden="true"></i> Check again
                        </a>
                        <form method="post" action="/Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-light w-100">
                                <i class="mdi mdi-logout me-1" aria-hidden="true"></i> Sign out
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <footer class="footer footer-alt">Nirvana CMS &middot; Sonic Core System</footer>

    <!-- bundle -->
    <script src="/BackOffice/js/vendor.min.js"></script>
    <script src="/BackOffice/js/app.min.js"></script>

</body>

</html>
