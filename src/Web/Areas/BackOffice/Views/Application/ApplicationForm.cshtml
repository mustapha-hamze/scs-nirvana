@{
    Layout = null;
}
@model Application.Contracts.General.ApplicationDto
<form class="needs-validation row g-3" novalidate id="frmApplication" method="POST">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LogoFileName" />
    <div asp-validation-summary="All" class="alert alert-danger col-12 mb-0" role="alert">
    </div>
    <div class="col-md-6">
        <label class="form-label scs-required" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="4" maxlength="64">
        <div class="invalid-feedback">Enter a title between 4 and 64 characters.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label scs-required" asp-for="Description">Description</label>
        <textarea class="form-control" asp-for="Description" required minlength="32" maxlength="512" rows="3"
            aria-describedby="applicationDescriptionHelp"></textarea>
        <div class="form-text" id="applicationDescriptionHelp">Shown on the workspace picker. 32 to 512 characters.</div>
        <div class="invalid-feedback">Enter a description between 32 and 512 characters.</div>
    </div>
    <div class="col-12">
        <label for="file-upload-ApplicationLogo" class="form-label scs-required">Logo</label>
        <input id="file-upload-ApplicationLogo" type="file" name="ApplicationLogo" class="form-control" required
            accept="image/*">
        <div class="invalid-feedback">Choose a logo image.</div>
    </div>
    <div class="col-12 scs-author-actions justify-content-end">
        <button type="button" class="btn scs-btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveApplicationForm()">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Create workspace
        </button>
    </div>
</form>
