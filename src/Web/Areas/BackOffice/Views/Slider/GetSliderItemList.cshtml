@{
    Layout = null;
    var accesses = await userManagementServices.GetUserAccesses(User.Identity.Name);
    if (accesses == string.Empty)
        accesses = "NULL";

    var _version = Guid.NewGuid();
}
@inject Services.UserManagementServices.IUserManagementServices userManagementServices
@model List<Domains.Entities.CustomModule.SliderItem>
<table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>
                    <img src="/Storage/Slider/@item.SliderId/@item.ImageFileName?@_version" width="290" alt="" srcset="">
                </td>
                <td>
                    @if (User.IsInRole("SuperAdmin") || accesses.Contains("SCM3000_1001_ACTIVITY_1003"))
                    {
                        @if (item.IsActive)
                        {
                            <button onclick="deactiveSliderItem(@item.Id)" type="button"
                                class="btn btn-sm btn-success p-1">Active</button>
                        }
                        else
                        {
                            <button onclick="activeSliderItem(@item.Id)" type="button"
                                class="btn btn-sm btn-danger p-1">Deactive</button>
                        }
                    }
                    @if (User.IsInRole("SuperAdmin") || accesses.Contains("SCM3000_1001_DELETE_1004"))
                    {
                        <button onclick="deleteSliderItem(@item.Id)" type="button"
                            class="btn btn-sm btn-danger p-1 ml-2">Delete</button>
                    }
                    @if (User.IsInRole("SuperAdmin") || accesses.Contains("SCM3000_1001_UPDATE_1005"))
                    {
                        <button onclick="editSliderItem(@item.Id, @item.SliderId)" type="button"
                            class="btn btn-sm btn-primary p-1 ml-2">Edit</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>