@model SliderItemListViewModel
@{
    Layout = null;
}
<table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>
                    <img src="/Storage/Slider/@item.SliderId/@item.ImageFileName?@Model.ImageVersion" width="290" alt="" srcset="">
                </td>
                <td>
                    @if (Model.CanToggleActivity)
                    {
                        @if (item.IsActive)
                        {
                            <button onclick="deactiveSliderItem(@item.Id)" type="button"
                                class="btn btn-sm btn-success p-1" title="Active — click to deactivate">Active</button>
                        }
                        else
                        {
                            <button onclick="activeSliderItem(@item.Id)" type="button"
                                class="btn btn-sm btn-danger p-1" title="Inactive — click to activate">Inactive</button>
                        }
                    }
                    @if (Model.CanDelete)
                    {
                        <button onclick="deleteSliderItem(@item.Id)" type="button"
                            class="btn btn-sm btn-danger p-1 ml-2">Delete</button>
                    }
                    @if (Model.CanUpdate)
                    {
                        <button onclick="editSliderItem(@item.Id, @item.SliderId)" type="button"
                            class="btn btn-sm btn-primary p-1 ml-2">Edit</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
