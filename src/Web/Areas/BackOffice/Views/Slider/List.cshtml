@model SliderListViewModel
@{
    Layout = null;
}

<table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>
                    @if (item.CanAccessItems)
                    {
                        <a href="javascript: void(0);" class="action-icon" data-bs-toggle="modal"
                            data-bs-target="#sliderItem-modal" onclick="sliderItems('@item.Id')" title="Manage Items"
                            aria-label="Manage items for @item.Title">
                            <i class="mdi mdi-menu"></i>
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
