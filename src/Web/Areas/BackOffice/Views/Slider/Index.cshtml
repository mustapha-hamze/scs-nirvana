@{
    ViewData["Title"] = "Sliders";
}

@section PageHelper { Create and maintain visual slider collections for this workspace. }

@* Create renders the new-slider bar here when the user can add sliders. *@
<div id="sliderFormPlaceHolder"></div>

<div class="card">
    <div class="card-body">
        <div class="scs-table-wrap" id="findSlidersResultBody"></div>
    </div>
</div>
<script src="/BackOffice/js/features/slider.js"></script>
@await Html.PartialAsync("__SliderItemModal")
@section Scripts {
    <script>
        getSliderList();
        getSliderForm();
    </script>
}
