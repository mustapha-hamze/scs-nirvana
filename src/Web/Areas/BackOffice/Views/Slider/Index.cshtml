@{
    ViewData["Title"] = "Sliders";
}

<div class="scs-page-header">
    <div>
        <h1 class="scs-page-title">Sliders</h1>
        <p class="scs-page-helper">Create and maintain visual slider collections for this workspace.</p>
    </div>
</div>

<div class="row mb-3" id="sliderFormPlaceHolder">
</div>

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findSlidersResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>
<script src="/BackOffice/js/features/slider.js"></script>
@await Html.PartialAsync("__SliderItemModal")
@section Scripts {
    <script>
        getSliderList();
        getSliderForm();
    </script>
}
