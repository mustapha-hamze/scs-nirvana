@model SliderItemFormViewModel
@{
    Layout = null;
}
<form action="" method="post" id="__frmCreateSliderItemForm__">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SliderId" id="__sliderItem_FRM_SliderId" value="@Model.SliderId">
    <input type="hidden" asp-for="CreatedDT" id="CreatedDT" value="@Model.CreatedDT">
    <input type="hidden" asp-for="UpdatedDT" id="UpdatedDT" value="@Model.UpdatedDT">
    <input type="hidden" asp-for="IsDeleted" id="IsDeleted" value="@Model.IsDeleted">
    <input type="hidden" asp-for="IsActive" id="IsActive" value="@Model.IsActive">
    <input type="hidden" asp-for="ImageFileName" id="__sliderItem_FRM_ImageFileName" value="@Model.ImageFileName">
    <input type="hidden" asp-for="Id" id="__sliderItem_FRM_Id" value="@Model.Id">
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Title" id="Title" asp-for="Title" value="@Model.Title">
        </div>
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Link" id="Link" asp-for="Link" value="@Model.Link">
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <textarea type="text" class="form-control" placeholder="Description" id="Description" asp-for="Description"
                value="@Model.Description"></textarea>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <input type="file" name="" id="sliderItemImage" class="form-control">
        </div>
        @if (Model.Id != 0)
        {
            <div class="col-md-12 mt-3">
                <img asp-append-version="true" style="width: 100%;"
                    src="/Storage/Slider/@Model.SliderId/@Model.ImageFileName?@Model.ImageVersion" alt="">
            </div>
        }
    </div>
</form>
<div class="row">
    <div class="col-md-12">
        @if (Model.CanCreateItem)
        {
            if (Model.Id == 0)
            {
                <button class="btn btn-primary" id="__btnCreateSliderItem__" onclick="createSliderItem()" type="button">Create
                    slider item</button>
            }
        }
        @if (Model.CanUpdateItem)
        {
            if (Model.Id != 0)
            {
                <button class="btn btn-primary" id="__btnUpdateSliderItem__" onclick="updateSliderItem()" type="button">Update
                    slider item</button>
                <button class="btn btn-danger" id="__btnNewSliderItem__" onclick="getSliderItemsForm(@Model.SliderId)"
                    type="button">New
                    slider item</button>
            }
        }
    </div>
</div>
