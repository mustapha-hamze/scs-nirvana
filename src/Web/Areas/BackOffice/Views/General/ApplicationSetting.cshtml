@{
    ViewData["Title"] = "Application Settings";
}

@section PageHelper { Manage configuration values for this workspace. }

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#general-modal"
        onclick="newApplicationSettingForm()">
        <i class="uil uil-plus" aria-hidden="true"></i>
        Add Setting
    </button>
}

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findApplicationSettingResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>
@await Html.PartialAsync("__GeneralModal")
@await Html.PartialAsync("__GeneralJSFunctions")
@section Scripts {
    <script>
        $(document).ready(function () {
            findApplicationSetting();
        });
    </script>
}