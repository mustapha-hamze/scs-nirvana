@using Application.UseCases.Utilities.ApplicationConst
@model Application.Contracts.General.TagDto
@{
    ViewData["Title"] = "Tags";
}

@section PageHelper { Manage the tags editors attach to content. }

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#general-modal"
        onclick="newTagForm()">
        <i class="uil uil-plus" aria-hidden="true"></i>
        Add Tag
    </button>
}

<div class="card">
    <div class="card-body">
        @* The list renders here; DataTables supplies search, sorting, paging and export. *@
        <div class="scs-table-wrap" id="findTagsResultBody"></div>
    </div>
</div>

@await Html.PartialAsync("__GeneralModal")
@await Html.PartialAsync("__GeneralJSFunctions")
@section Scripts {
    <script>
        $(document).ready(function () {
            findTags();
        });
    </script>
}