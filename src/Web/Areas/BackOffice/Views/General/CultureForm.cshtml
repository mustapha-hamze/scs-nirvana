@{
    Layout = null;
}

@using Services.Utilities.ApplicationConst
@model Application.Contracts.General.CultureDto
<form class="needs-validation row" novalidate id="frmCulture" method="POST">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="mb-3 col-md-6">
        <label class="form-label" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" placeholder="Title" required minlength="4"
            maxlength="64">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
    <div class="mb-3 col-md-6">
        <label class="form-label" asp-for="Key">Key</label>
        <input type="text" class="form-control" asp-for="Key" placeholder="Key" required minlength="4" maxlength="8">
        <small>e.g for United Kingdom "en-GB"</small>
        <div class="invalid-feedback">
            Min length is 4 and max length is 8
        </div>
    </div>
</form>
<button class="btn btn-primary mt-2" onclick="saveCultureForm()">Submit form</button>