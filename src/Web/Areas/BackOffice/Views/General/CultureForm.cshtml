@{
    Layout = null;
}

@using Application.UseCases.Utilities.ApplicationConst
@model Application.Contracts.General.CultureDto
<form class="needs-validation row g-3" novalidate id="frmCulture" method="POST">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="col-md-7">
        <label class="form-label scs-required" asp-for="Title">Name</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="4" maxlength="64"
            aria-describedby="cultureTitleHelp">
        <div class="form-text" id="cultureTitleHelp">The language name editors see, e.g. "English (UK)".</div>
        <div class="invalid-feedback">Enter a name between 4 and 64 characters.</div>
    </div>
    <div class="col-md-5">
        <label class="form-label scs-required" asp-for="Key">Culture code</label>
        <input type="text" class="form-control" asp-for="Key" required minlength="4" maxlength="8"
            autocomplete="off" spellcheck="false" aria-describedby="cultureKeyHelp">
        <div class="form-text" id="cultureKeyHelp">Language-region code, e.g. "en-GB" or "fa-IR".</div>
        <div class="invalid-feedback">Enter a code between 4 and 8 characters, such as en-GB.</div>
    </div>
    <div class="col-12 scs-author-actions justify-content-end">
        <button type="button" class="btn scs-btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveCultureForm()">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Save culture
        </button>
    </div>
</form>
