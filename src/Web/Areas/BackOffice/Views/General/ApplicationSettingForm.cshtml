@{
    Layout = null;
}

@model Application.Contracts.General.ApplicationSettingDto
@using Application.UseCases.Utilities.ApplicationConst

<form class="needs-validation row g-3" novalidate id="frmApplicationSetting" method="POST">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ApplicationId" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="col-md-6">
        <label class="form-label scs-required" asp-for="SettingId">Setting</label>
        <select class="form-select" asp-for="SettingId">
            <option value="@ApplicationSettingId.ContentImageSize">Content Image Size</option>
            <option value="@ApplicationSettingId.ContentImageAspectRatio">Content Image Aspect Ratio</option>
            <option value="@ApplicationSettingId.FrontContentTypes">Front Content Types</option>
            <option value="@ApplicationSettingId.DevelopmentImageSize">Development Image Size</option>
            <option value="@ApplicationSettingId.DevelopmentImageAspectRatio">Development Image Aspect Ratio</option>
            <option value="@ApplicationSettingId.PropertyImageSize">Property Image Size</option>
            <option value="@ApplicationSettingId.PropertyImageAspectRatio">Property Image Aspect Ratio</option>
            <option value="@ApplicationSettingId.DefaultCurrency">Default Currency</option>
            <option value="@ApplicationSettingId.WebsiteUrl">Website Url</option>
            <option value="@ApplicationSettingId.WebsitePage">Website Page</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label scs-required" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="4" maxlength="256"
            aria-describedby="applicationSettingTitleHelp">
        <div class="form-text" id="applicationSettingTitleHelp">A name that tells this value apart, e.g. "Thumbnail".</div>
        <div class="invalid-feedback">Enter a title between 4 and 256 characters.</div>
    </div>
    <div class="col-12">
        <label class="form-label scs-required" asp-for="Value">Value</label>
        <input type="text" class="form-control" asp-for="Value" required minlength="1" maxlength="64"
            spellcheck="false" aria-describedby="applicationSettingValueHelp">
        <div class="form-text" id="applicationSettingValueHelp">For image sizes, enter width-height in pixels, e.g. 1920-1080.</div>
        <div class="invalid-feedback">Enter a value of up to 64 characters.</div>
    </div>
    <div class="col-12 scs-author-actions justify-content-end">
        <button type="button" class="btn scs-btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveApplicationSettingForm()">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Save setting
        </button>
    </div>
</form>
