<script>
    function newTagForm() {
        $("#generalModalLabel").html("Add new tag");
        clearModalBody("generalModalBody");
        $.ajax({
            url: '/BackOffice/General/TagForm',
            type: "GET"
        }).done(function (data) {
            $("#generalModalBody").html(data);
        });
    }

    function saveTagForm() {
        if (checkFormValidity('frmTag')) {
            var frmTag = $("#frmTag");

            clearModalBody("generalModalBody");

            $.ajax({
                type: "POST",
                url: "/BackOffice/General/SaveTagForm",
                data: frmTag.serialize()
            }).done(function (data) {
                $("#selectTagTypeId").val(data);
                findTags();
                $('#general-modal').modal('hide');
            });
        }
    }

    function findTags() {
        clearModalBody("findTagsResultBody");
        $.ajax({
            url: '/BackOffice/General/TagList',
            type: "GET"
        }).done(function (data) {
            $("#findTagsResultBody").html(data);
            $("#datatable-buttons").DataTable({
                lengthChange: !1,
                buttons: ["copy", "print"],
                language: {
                    paginate: {
                        previous: "<i class='mdi mdi-chevron-left'>",
                        next: "<i class='mdi mdi-chevron-right'>"
                    }
                },
                drawCallback: function () {
                    $(".dataTables_paginate > .pagination").addClass("pagination-rounded")
                }
            });
        });
    }

    function newCultureForm() {
        $("#generalModalLabel").html("Add new culture");
