    function findZones() {
        clearModalBody("findZonesResultBody");
        $.ajax({
            url: '/BackOffice/General/ZoneList',
            type: "GET"
        }).done(function (data) {
            $("#findZonesResultBody").html(data);
            $("#datatable-buttons").DataTable({
                sAjaxSource: "/BackOffice/General/ZoneListJsonData",
                bServerSide: true,
                bProcessing: true,
                fixedHeader: {
                    headerOffset: 50
                },
                bSearchable: true,
                pageLength: 25,
                language: {
                    paginate: {
                        previous: "<i class='mdi mdi-chevron-left'>",
                        next: "<i class='mdi mdi-chevron-right'>"
                    },
                    "emptyTable": "No record found.",
                    "processing":
                        '<div class="p-5 text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden"></span></div></div>'
                }, "columns": [
                    {
                        "data": "id",
                        "autoWidth": true,
                        "searchable": true
                    },
                    {
                        "data": "title",
                        "autoWidth": true,
                        "searchable": true
                    },
                    {
                        "data": "parentTitle",
                        "autoWidth": true,
                        "searchable": true
                    }, {
                        "data": "createdDT",
                        "autoWidth": true,
                        "searchable": true
                    },
                    {
                        "data": 'id',
                        "autoWidth": true,
                        "searchable": false,
                        "sortable": false,
                        render: (data, type, row) => {
                            return `<a href="javascript: void(0);" class="action-icon">
                                        <i class="mdi mdi-delete"></i>
                                    </a>`;
                        }
                    }
                ],
                drawCallback: function () {
                    $(".dataTables_paginate > .pagination").addClass("pagination-rounded")
                }
            });
        });
    }

