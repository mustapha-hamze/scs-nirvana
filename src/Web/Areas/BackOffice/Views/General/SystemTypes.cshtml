@{
    ViewData["Title"] = "Content Types";
    ViewData["PageHelper"] = "Manage the system type definitions used across content, schemas, and other modules.";
    ViewData["Breadcrumb"] = new BackOfficeCrumb[] { new("General Settings") };
}

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#general-modal"
        onclick="newSystemTypeForm()">
        <i class="uil uil-plus" aria-hidden="true"></i>
        Add Type
    </button>
}

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findSystemTypesResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>

@await Html.PartialAsync("__GeneralModal")
@await Html.PartialAsync("__GeneralJSFunctions")
@section Scripts {
    <script>
        $(document).ready(function () {
            findSystemTypes();
        });
    </script>
}
