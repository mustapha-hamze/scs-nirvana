@{
    ViewData["Title"] = "Content Types";
}

@section PageHelper { Manage the system type definitions used across content, schemas, and other modules. }

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#general-modal"
        onclick="newSystemTypeForm()">
        <i class="uil uil-plus" aria-hidden="true"></i>
        Add Type
    </button>
}

<div class="card">
    <div class="card-body">
        @* The list renders here; DataTables supplies search, sorting, paging and export. *@
        <div class="scs-table-wrap" id="findSystemTypesResultBody"></div>
    </div>
</div>

@await Html.PartialAsync("__GeneralModal")
@await Html.PartialAsync("__GeneralJSFunctions")
@section Scripts {
    <script>
        $(document).ready(function () {
            findSystemTypes();
        });
    </script>
}
