@{
    ViewData["Title"] = "Content Types";
}

<ul class="scs-breadcrumb">
    <li><a href="/BackOffice/Home/Index">Dashboard</a></li>
    <li>General Settings</li>
    <li>Content Types</li>
</ul>
<div class="scs-page-header">
    <div>
        <h1 class="scs-page-title">Content Types</h1>
        <p class="scs-page-helper">Manage the system type definitions used across content, schemas, and other modules.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#general-modal"
            onclick="newSystemTypeForm()">
            <i class="uil uil-plus"></i>
            Add Type
        </button>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findSystemTypesResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>

@await Html.PartialAsync("__GeneralModal")
@await Html.PartialAsync("__GeneralJSFunctions")
@section Scripts {
    <script>
        $(document).ready(function () {
            findSystemTypes();
        });
    </script>
}