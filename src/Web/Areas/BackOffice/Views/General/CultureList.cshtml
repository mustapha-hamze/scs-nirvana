@{
    Layout = null;
}

@model List<Application.Contracts.General.CultureDto>

@if (Model.Count == 0)
{
    <div class="scs-empty-state">
        <i class="mdi mdi-translate" aria-hidden="true"></i>
        No cultures yet. Use Add Culture to add the first language.
    </div>
}
else
{
    <table id="datatable-buttons" class="table table-hover dt-responsive nowrap w-100">
        <thead>
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="scs-cell-truncate" title="@item.Title">@item.Title</td>
                    <td><code class="scs-code">@item.Key</code></td>
                    <td data-order="@item.CreatedDT.ToString("yyyy-MM-ddTHH:mm:ss")">@item.CreatedDT.ToString("yyyy MMM dd, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
