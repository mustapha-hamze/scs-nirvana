@{
    Layout = null;
}
@using Application.UseCases.Utilities.ApplicationConst
@model Application.Contracts.General.TagDto
<form class="needs-validation row g-3" novalidate id="frmTag" method="POST">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="col-md-7">
        <label class="form-label scs-required" asp-for="Title">Tag</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="4" maxlength="64">
        <div class="invalid-feedback">Enter a tag between 4 and 64 characters.</div>
    </div>
    <div class="col-md-5">
        <label class="form-label" asp-for="TypeId">Used for</label>
        <select class="form-select" asp-for="TypeId">
            <option value="@TypeId.Content">Content</option>
            <option value="@TypeId.PTEDevelopmentType">Development</option>
            @* <option value="@TypeId.Property">Property</option> *@
        </select>
    </div>
    <div class="col-12 scs-author-actions justify-content-end">
        <button type="button" class="btn scs-btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveTagForm()">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Save tag
        </button>
    </div>
</form>
