@model Application.Contracts.General.CultureDto
@{
    ViewData["Title"] = "Cultures";
}

@section PageHelper { Manage the languages content can be published in. }

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#general-modal"
        onclick="newCultureForm()">
        <i class="uil uil-plus" aria-hidden="true"></i>
        Add Culture
    </button>
}

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findCulturesResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>

@await Html.PartialAsync("__GeneralModal")
@await Html.PartialAsync("__GeneralJSFunctions")
@section Scripts {
    <script>
        $(document).ready(function () {
            findCultures();
        });
    </script>
}