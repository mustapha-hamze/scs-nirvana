@{
    Layout = null;
}
@using Application.UseCases.Utilities.ApplicationConst
@model Application.Contracts.General.SystemTypeDto
<form class="needs-validation row g-3" novalidate id="frmSystemType" method="POST">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger col-12 mb-0" role="alert">
    </div>
    <div class="col-md-6">
        <label class="form-label scs-required" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="4" maxlength="64">
        <div class="invalid-feedback">Enter a title between 4 and 64 characters.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label scs-required" asp-for="TypeGroupId">Type group</label>
        <select class="form-select" asp-for="TypeGroupId" required>
            <option value="@TypeId.Content">Content</option>
            <option value="@TypeId.ContentAttachment">Content Attachment</option>
            <option value="@TypeId.ContentSchema">Content Schema</option>
            <option value="@TypeId.PTEDevelopmentType">Development Type</option>
            <option value="@TypeId.PTEPropertyType">Property</option>
            <option value="@TypeId.Company">Company</option>
            <option value="@TypeId.SystemCustomMuddle">System Custom Muddle</option>
            <option value="@TypeId.User">User</option>

            <option value="@TypeId.PTEAttributeGroup">PT Attribute Group</option>
            <option value="@TypeId.PTEAttributeGroupItem">PT AttributeGroupItem</option>
            <option value="@TypeId.PTEDevelopmentUsageType">Development Usage Type</option>
            <option value="@TypeId.PTEDevelopmentDealType">Development Deal Type</option>
            <option value="@TypeId.PTEDevelopmentConstructionType">Development Construction Type</option>
            <option value="@TypeId.PTEDevelopmentAttachment">Development Attachment</option>
            <option value="@TypeId.PTEPropertyAttachment">Property Attachment</option>
            <option value="@TypeId.UserGroup">User Group</option>
        </select>
        <div class="form-text">The group this type belongs to.</div>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="IsRTL" aria-describedby="systemTypeRtlHelp">
            <label class="form-check-label" asp-for="IsRTL">Right-to-left</label>
        </div>
        <div class="form-text" id="systemTypeRtlHelp">Tick when this type's content is written right to left.</div>
    </div>
    <div class="col-12 scs-author-actions justify-content-end">
        <button type="button" class="btn scs-btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveSystemTypeForm()">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Save type
        </button>
    </div>
</form>
