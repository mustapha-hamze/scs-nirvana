}

@model Infrastructure.Dto.GeneralDtos.CurrencyDto;

<div class="row mb-2 mt-2">
    <div class="col-md-12 p-0">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#general-modal"
            onclick="newCurrencyForm()">
            <i class="uil uil-plus"></i>
            Add Currency
        </button>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findCurrencysResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>

@await Html.PartialAsync("__GeneralModal")
@await Html.PartialAsync("__GeneralJSFunctions")
@section Scripts {
    <script>
        $(document).ready(function () {
            findCurrencies();
        });
    </script>
}