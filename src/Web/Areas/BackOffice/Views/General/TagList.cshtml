@{
    Layout = null;
}
@using Application.UseCases.Utilities.ApplicationConst
@model List<Application.Contracts.General.TagDto>

@if (Model.Count == 0)
{
    <div class="scs-empty-state">
        <i class="mdi mdi-tag-outline" aria-hidden="true"></i>
        No tags yet. Use Add Tag to create the first one.
    </div>
}
else
{
    <table id="datatable-buttons" class="table table-hover dt-responsive nowrap w-100">
        <thead>
            <tr>
                <th>Tag</th>
                <th>Used for</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="scs-cell-truncate" title="@item.Title">@item.Title</td>
                    <td>
                        @switch (item.TypeId)
                        {
                            case TypeId.Content:
                                <text>Content</text>
                                break;
                            case TypeId.PTEDevelopmentType:
                                <text>Development</text>
                                break;
                            case 100:
                                <text>CMS</text>
                                break;
                            case 200:
                                <text>PropTech</text>
                                break;
                        }
                    </td>
                    <td data-order="@item.CreatedDT.ToString("yyyy-MM-ddTHH:mm:ss")">@item.CreatedDT.ToString("yyyy MMM dd, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
