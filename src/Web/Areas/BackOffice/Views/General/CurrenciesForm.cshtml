@{
    Layout = null;
    var cultures = (List<Application.Contracts.General.CultureDto>)ViewData["Cultures"];
}

@using Services.Utilities.ApplicationConst
@model Infrastructure.Dto.GeneralDtos.CurrencyDto

<form class="needs-validation row" novalidate id="frmCurrency" method="POST">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsActive" />
    <input type="hidden" asp-for="IsDeleted" />
    <input type="hidden" asp-for="CreatedDT" />
    <input type="hidden" asp-for="UpdatedDT" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="mb-6 col-md-6 mb-2">
        <label class="form-label" asp-for="Name">Name</label>
        <input type="text" class="form-control" asp-for="Name" placeholder="Name" required minlength="4" maxlength="64">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
