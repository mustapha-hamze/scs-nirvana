<script>
    function findSchemas() {
        clearModalBody("findSchemasResultBody");
        $.ajax({
            url: '/BackOffice/Schema/SchemaList',
            type: "GET"
        }).done(function (data) {
            $("#findSchemasResultBody").html(data);
            $("#datatable-buttons").DataTable({
                lengthChange: !1,
                buttons: ["copy", "print"],
                language: {
                    paginate: {
                        previous: "<i class='mdi mdi-chevron-left'>",
                        next: "<i class='mdi mdi-chevron-right'>"
                    }
                },
                drawCallback: function () {
                    $(".dataTables_paginate > .pagination").addClass("pagination-rounded")
                }
            });
        });
    }

    function schemaForm(id = 0) {
        clearModalBody("schemaModalBody");
        $.ajax({
            url: '/BackOffice/Schema/SchemaForm/' + id,
            type: "GET"
        }).done(function (data) {
            $("#schemaModalBody").html(data);
        });
    }

    function saveSchemaForm() {
        if (checkFormValidity('frmSchema')) {
            var frmApplication = $("#frmSchema");

            var fileUpload = $("#file-upload-SchemaLogo").get(0);
            var files = fileUpload.files;
            if (fileUpload.files.length != 0) {
                var file = files[0];
            }

            clearModalBody("schemaModalBody");

            $.ajax({
                type: "POST",
                url: "/BackOffice/Schema/SaveSchemaForm",
                data: frmApplication.serialize()
            }).done(function (data) {
                var result = data.split('|');
                if (result[0] === "Done") {
                    if (fileUpload.files.length != 0) {
                        uploadFile(file, "/BackOffice/Schema/UploadSchemaLogo", result[1]);
                    }
                    else {
                        location.reload();
                    }
                }
                else {
                    $("#schemaModalBody").html(data);
                }
            });
        }
    }

    function newSchemaDetailsForm(schemaId) {
        clearModalBody("schema_details_form");
        clearModalBody("schema_details_list");

        $.ajax({
            url: '/BackOffice/Schema/SchemaDetailsForm/' + schemaId,
            type: "GET"
        }).done(function (data) {
            $("#schema_details_form").html(data);
        });

        $.ajax({
            url: '/BackOffice/Schema/SchemaDetailsList/' + schemaId,
            type: "GET"
        }).done(function (data) {
            $("#schema_details_list").html(data);
        });
    }

    function saveSchemaDetailsForm() {
        if (checkFormValidity('frmSchemaDetails')) {
            setLoadingForBtn("btnSaveSchemaDetailsForm");
            var frmSchemaDetails = $("#frmSchemaDetails");
            $.ajax({
                url: '/BackOffice/Schema/SchemaDetailsFormSave',
                type: "POST",
                data: frmSchemaDetails.serialize()
            }).done(function (data) {
                if (data === "Done") {
                    newSchemaDetailsForm($("#hideSchemaId").val());
                    removeLoadingForBtn("btnSaveSchemaDetailsForm", "saveSchemaDetailsForm()", "Submit form");
                }
            });
        }
    }

    function removeLogo() {
        $("#schemaLogoUploaderPlaceHolder").show();
        $("#schemaLogoPreviewPlaceHolder").hide();
        $("#file-upload-SchemaLogo").attr("required", "required");
    }

    function deleteSchema(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/BackOffice/Schema/DeleteSchema/' + id,
                    type: "GET"
                }).done(function (data) {
                    if (data === "Done") {
                        messageBox("Deleted!", "Selected item has been deleted.", "success")
                        findSchemas();
                    } else {
                        messageBox("Error!", "Selected item has not been deleted.", "error")
                    }
                });
            }
        });
    }
</script>