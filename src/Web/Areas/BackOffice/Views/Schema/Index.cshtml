@{
    ViewData["Title"] = "Schemas";
}

<ul class="scs-breadcrumb">
    <li><a href="/BackOffice/Home/Index">Dashboard</a></li>
    <li>Content Management</li>
    <li>Schemas</li>
</ul>
<div class="scs-page-header">
    <div>
        <h1 class="scs-page-title">Schemas</h1>
        <p class="scs-page-helper">Define structured, reusable data schemas for your content types.</p>
    </div>
    <div>
        <button class="btn btn-primary" data-bs-toggle="modal" onclick="schemaForm()" data-bs-target="#schema-modal">
            <i class="uil uil-plus"></i>
            Create Schema
        </button>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="tab-content">
                    <div class="table-responsive-sm" id="findSchemasResultBody">

                    </div> <!-- end table-responsive-->
                </div> <!-- end card body-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>


@await Html.PartialAsync("__SchemaDetailsModal")
@await Html.PartialAsync("__SchemaModal")
@await Html.PartialAsync("__SchemaJSFunctions")
@section Scripts {
    <script>
        findSchemas();
    </script>
}