@{
    Layout = null;
}

@model Application.Contracts.CMS.SchemaDto

<form class="needs-validation row g-3" novalidate id="frmSchema" method="POST">
    <input type="hidden" asp-for="Id" id="hidSchemaId" />
    <input type="hidden" asp-for="ApplicationId" />
    <input type="hidden" asp-for="IsActive" />
    <input type="hidden" asp-for="IsDeleted" />
    <input type="hidden" asp-for="CreatedDT" />
    <input type="hidden" asp-for="UpdatedDT" />
    <input type="hidden" asp-for="LogoFileName" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="col-md-7">
        <label class="form-label scs-required" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="4" maxlength="64">
        <div class="invalid-feedback">Enter a title between 4 and 64 characters.</div>
    </div>
    <div class="col-md-5">
        <label class="form-label" asp-for="TypeId">Used for</label>
        <select class="form-select" asp-for="TypeId">
            <option value="1000">Content</option>
            <option value="1001">Pages</option>
        </select>
    </div>

    @if (Model.Id == 0)
    {
        <div class="col-12">
            <label class="form-label scs-required" for="file-upload-SchemaLogo">Logo</label>
            <input type="file" class="form-control" name="SchemaLogo" id="file-upload-SchemaLogo" accept="image/*"
                aria-describedby="schemaLogoHelp" required />
            <div class="form-text" id="schemaLogoHelp">Shown on the schema tile in the content editor. A square image works best.</div>
            <div class="invalid-feedback">Choose a logo image.</div>
        </div>
    }
    else
    {
        <div class="col-12" style="display: none;" id="schemaLogoUploaderPlaceHolder">
            <label class="form-label" for="file-upload-SchemaLogo">New logo</label>
            <input type="file" class="form-control" name="SchemaLogo" id="file-upload-SchemaLogo" accept="image/*"
                aria-describedby="schemaLogoHelp" />
            <div class="form-text" id="schemaLogoHelp">Shown on the schema tile in the content editor. A square image works best.</div>
            <div class="invalid-feedback">Choose a logo image, or close without saving to keep the current one.</div>
        </div>
        <div class="col-12" id="schemaLogoPreviewPlaceHolder">
            <span class="form-label d-block">Logo</span>
            <div class="scs-logo-field">
                <figure class="scs-media-card scs-logo-preview">
                    <span class="scs-media-thumb">
                        <img id="hover-on-image" src="/Storage/Schema/Logos/@Model.LogoFileName" asp-append-version="true"
                            alt="Current logo for @Model.Title" />
                    </span>
                </figure>
                <button type="button" onclick="removeLogo()" class="btn btn-sm btn-outline-secondary">
                    <i class="mdi mdi-image-edit-outline" aria-hidden="true"></i>
                    Replace logo
                </button>
            </div>
        </div>
    }

    <div class="col-12 scs-author-actions justify-content-end">
        <button type="button" class="btn scs-btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="button" onclick="saveSchemaForm()" class="btn btn-primary">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Save schema
        </button>
    </div>
</form>
