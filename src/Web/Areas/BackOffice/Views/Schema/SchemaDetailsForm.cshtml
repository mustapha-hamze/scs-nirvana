@{
    Layout = null;
    var types = (List<Infrastructure.Dto.GeneralDtos.SystemTypeDto>)ViewData["Types"];
}
@using Services.Utilities.ApplicationConst;
@model Infrastructure.Dto.CMSDtos.SchemaDetailsDto

<form class="needs-validation row" novalidate id="frmSchemaDetails" method="POST">
    <input type="hidden" asp-for="SchemaId" id="hideSchemaId" value="@ViewData["SchemaId"]" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" placeholder="Title" required minlength="4"
            maxlength="64">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="TypeId">TypeId</label>
        <select class="form-control" asp-for="TypeId">
            <option value="1000">Input Text</option>
            <option value="1001">Image</option>
            <option value="1002">Text Editor</option>
            <option value="1003">Image Gallery</option>
            <option value="1004">File Upload</option>
            <option value="1005">Text Area</option>
            <option value="1006">Headline 1</option>
            <option value="1007">Headline 2</option>
            <option value="1008">Headline 3</option>
            <option value="1009">Headline 4</option>
            <option value="1010">Headline 5</option>
            <option value="1011">Headline 6</option>
        </select>
    </div>
    <div class="col-md-6 mb-2">
        <label class="form-label" asp-for="Size">Size</label>
        <input type="text" class="form-control" asp-for="Size" required>
        </select>
        <div class="invalid-feedback">
            It must be a number 1 between 12
        </div>
    </div>
    <div class="mb-3 col-md-12">
        <a href="javascript: void(0);" id="btnSaveSchemaDetailsForm" class="btn btn-primary mt-2"
            onclick="saveSchemaDetailsForm()"><i class="uil uil-file-check-alt"></i> Save Schema Detail</a>
    </div>
</form>