@{
    Layout = null;
    var types = (List<Application.Contracts.General.SystemTypeDto>)ViewData["Types"];
}
@using Application.UseCases.Utilities.ApplicationConst;
@model Application.Contracts.CMS.SchemaDetailsDto

<form class="needs-validation row g-3 align-items-start" novalidate id="frmSchemaDetails" method="POST">
    <input type="hidden" asp-for="SchemaId" id="hideSchemaId" value="@ViewData["SchemaId"]" />
    <div asp-validation-summary="All" class="alert alert-danger col-12 mb-0" role="alert">
    </div>
    <div class="col-md-5">
        <label class="form-label scs-required" asp-for="Title">Field label</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="4" maxlength="64">
        <div class="invalid-feedback">Enter a label between 4 and 64 characters.</div>
    </div>
    <div class="col-sm-7 col-md-4">
        <label class="form-label" asp-for="TypeId">Field type</label>
        <select class="form-select" asp-for="TypeId">
            <option value="1000">Input Text</option>
            <option value="1001">Image</option>
            <option value="1002">Text Editor</option>
            <option value="1003">Image Gallery</option>
            <option value="1004">File Upload</option>
            <option value="1005">Text Area</option>
            <option value="1006">Headline 1</option>
            <option value="1007">Headline 2</option>
            <option value="1008">Headline 3</option>
            <option value="1009">Headline 4</option>
            <option value="1010">Headline 5</option>
            <option value="1011">Headline 6</option>
        </select>
    </div>
    <div class="col-sm-5 col-md-3">
        <label class="form-label scs-required" asp-for="Size">Width</label>
        <input type="number" class="form-control" asp-for="Size" required min="1" max="12" step="1"
            aria-describedby="schemaFieldSizeHelp">
        <div class="form-text" id="schemaFieldSizeHelp">Columns out of 12 in the editor.</div>
        <div class="invalid-feedback">Enter a whole number from 1 to 12.</div>
    </div>
    <div class="col-12 scs-author-actions justify-content-end mt-2">
        <button type="button" id="btnSaveSchemaDetailsForm" class="btn btn-primary"
            onclick="saveSchemaDetailsForm()"><i class="uil uil-plus" aria-hidden="true"></i> Add field</button>
    </div>
</form>
