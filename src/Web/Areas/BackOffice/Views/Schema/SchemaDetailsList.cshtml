@{
    Layout = null;
}

@model List<Application.Contracts.CMS.SchemaDetailsDto>

@if (Model.Count == 0)
{
    <div class="scs-empty-state scs-media-empty">
        <i class="mdi mdi-form-textbox" aria-hidden="true"></i>
        This schema has no fields yet. Add the first field above.
    </div>
}
else
{
    <table class="table table-hover table-centered mb-0">
        <thead>
            <tr>
                <th>Label</th>
                <th>Type</th>
                <th>Width</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="scs-cell-truncate" title="@item.Title">@item.Title</td>
                    <td>
                        @switch (item.TypeId)
                        {
                            case 1000:
                                <text>Input Text</text>
                                break;
                            case 1001:
                                <text>Image</text>
                                break;
                            case 1002:
                                <text>Text Editor</text>
                                break;
                            case 1003:
                                <text>Image Gallery</text>
                                break;
                            case 1004:
                                <text>File Upload</text>
                                break;
                            case 1005:
                                <text>Text Area</text>
                                break;
                            case 1006:
                                <text>Headline 1</text>
                                break;
                            case 1007:
                                <text>Headline 2</text>
                                break;
                            case 1008:
                                <text>Headline 3</text>
                                break;
                            case 1009:
                                <text>Headline 4</text>
                                break;
                            case 1010:
                                <text>Headline 5</text>
                                break;
                            case 1011:
                                <text>Headline 6</text>
                                break;
                        }
                    </td>
                    <td>@item.Size / 12</td>
                    <td>@item.CreatedDT.ToString("yyyy MMM dd, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
