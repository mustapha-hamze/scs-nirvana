<script>
    function newUserForm() {
        clearModalBody("userModalBody");

        $.ajax({
            url: '/BackOffice/Account/UserForm',
            type: "GET"
        }).done(function (data) {
            $("#userModalBody").html(data);
        });
    }

    function editUserForm(userId) {

        clearModalBody("userModalBody");

        $.ajax({
            url: '/BackOffice/Account/UserForm/' + userId,
            type: "GET"
        }).done(function (data) {
            $("#userModalBody").html(data);
        });
    }

    function saveUserForm() {
        if (checkFormValidity('frmUser')) {
            var frmUser = $("#frmUser");
            clearModalBody("userModalBody");
            $.ajax({
                type: "POST",
                url: '/BackOffice/Account/SaveUserForm/',
                data: frmUser.serialize()
            }).done(function (data) {
                if (data === "Done") {
                    location.reload();
                }
                else {
                    $("#userModalBody").html(data);
                }
            });
        }
    }

    function findUsers() {
        setLoadingForBtnFilter("btnUserFilter");
        var frmUserFilter = $("#frmUserFilters");
        $.ajax({
            url: '/BackOffice/Account/UserList',
            type: "POST",
            data: frmUserFilter.serialize(),
        }).done(function (data) {
            $("#findUsersResultBody").html(data);
            removeLoadingForBtnFilter("btnUserFilter", "findUsers()");
        });
    }

    function userSettingForm(userId, loadApplicationTab = false) {

        clearModalBody("userSettingModalBody");

        $.ajax({
            url: '/BackOffice/Account/UserSettingForm/' + userId,
            type: "GET"
        }).done(function (data) {
            $("#userSettingModalBody").html(data);
            if (loadApplicationTab) {
                $("#roleTabTitle").removeClass("active");
                $("#roles").removeClass("show");
                $("#roles").removeClass("active");

                $("#applicationTabTitle").addClass("active");
                $("#applications").addClass("show");
                $("#applications").addClass("active");
            }
        });
    }

    function addUserToRole(userId, roleName) {
        Swal.fire({
            title: "Are you sure?",
            text: "Role can give access to user",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Yes, add it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/BackOffice/Account/AddUserToRole/' + userId + "/" + roleName,
                    type: "POST"
                }).done(function (data) {
                    if (data === "Done") {
                        messageBox("Done !", "The user has been added to role.", "success")
                        userSettingForm(userId);
                    } else {
                        messageBox("Error!", "The user has not been removed from role.", "error")
                    }
                });
            }
        });
    }

    function removeUserFromRole(userId, roleName) {
        Swal.fire({
            title: "Are you sure?",
            text: "Role can give access to user",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Yes, remove it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/BackOffice/Account/RemoveUserFromRole/' + userId + "/" + roleName,
                    type: "POST"
                }).done(function (data) {
                    if (data === "Done") {
                        messageBox("Done !", "The role has been removed from user.", "success")
                        userSettingForm(userId);
                    } else {
                        messageBox("Error!", "The role has not been removed from user.", "error")
                    }
                });
            }
        });
    }

    function addUserToApplication(userId, applicationId) {
        Swal.fire({
            title: "Are you sure?",
            text: "User can have access to enter the application",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Yes, set it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/BackOffice/Account/AddUserToApplication/' + userId + "/" + applicationId,
                    type: "POST"
                }).done(function (data) {
                    if (data === "Done") {
                        messageBox("Done !", "The user has been added to application.", "success")
                        userSettingForm(userId, true);
                    } else {
                        messageBox("Error!", "The user has not been added from application.", "error")
                    }
                });
            }
        });
    }

    function removeUserFromApplication(userId, relationId) {
        Swal.fire({
            title: "Are you sure?",
            text: "User can have access to enter the application",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Yes, remove it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/BackOffice/Account/RemoveUserFromApplication/' + relationId,
                    type: "POST"
                }).done(function (data) {
                    if (data === "Done") {
                        messageBox("Done !", "The user has been removed from application.", "success")
                        userSettingForm(userId, true);
                    } else {
                        messageBox("Error!", "The user has not been removed from application.", "error")
                    }
                });
            }
        });
    }

    function sectors(userId) {
        clearModalBody("sectors");

        $.ajax({
            url: '/BackOffice/Account/Sectors/' + userId,
            type: "GET"
        }).done(function (data) {
            $("#sectors").html(data);
        });
    }

    function entities(userId) {
        clearModalBody("entities");
        $.ajax({
            url: '/BackOffice/Account/Entities/' + userId,
            type: "GET"
        }).done(function (data) {
            $("#entities").html(data);
            getApplicationSectors();
        });
    }

    function getApplicationSectors() {
        var applicationId = $("#__ddlApplications__").val();
        $.ajax({
            url: '/BackOffice/Account/GetApplicationSectors/' + applicationId,
            type: "GET"
        }).done(function (data) {
            $("#__ddlSectors__").html(data);
            getSectorEntities();
        });
    }

    function getUserAccess(userId) {
        $.ajax({
            url: '/BackOffice/Account/GetUserAccess/' + userId + "/" + $("#__ddlApplications__").val(),
            type: "GET"
        }).done(function (data) {
            var _data = data.split(',');
            $("#Accesses").val(data);
            $.each(_data, function () {
                var element = "#" + this;
                if (element !== "#") {
                    $("#" + this).prop("checked", true);
                }
            });
        });
    }

    function getSectorEntities() {
        var sectorId = $("#__ddlSectors__").val();
        clearModalBody("__checkBox_Entities__");
        $.ajax({
            url: '/BackOffice/Account/GetSectorEntities/' + sectorId,
            type: "GET"
        }).done(function (data) {
            $("#__checkBox_Entities__").html(data);
            getUserAccess($("#__hidTXTUserId__").val());
        });
    }

    function setEntityAccessHideInput(value) {

        if ($("#Accesses").val().search(value) == -1) {
            $("#Accesses").val($("#Accesses").val() + value + ",");
        }
        else {
            var accesses = $("#Accesses").val();
            accesses = accesses.replace(value + ",", '');
            $("#Accesses").val(accesses);
        }
    }

    function saveEntityAccess() {
        var frmSaveEntitiesToUser = $("#frmSaveEntitiesToUser");
        $.ajax({
            url: '/BackOffice/Account/SetAccessForUser',
            type: "POST",
            data: frmSaveEntitiesToUser.serialize(),
        }).done(function (data) {
            if (data === "Done") {
                entities(userId);
            }
        });
    }

    function loadEntityAccesses(accessKeyElement, entityId) {
        //console.log(accessKeyElement);
        //console.log(entityId);
        $("#" + accessKeyElement).attr('checked', 'checked');
        clearModalBody("div_accesses");
        $.ajax({
            url: '/BackOffice/Account/EntityAccesses/' + entityId,
            type: "GET"
        }).done(function (data) {
            $("#div_accesses").html(data);
            var _data = $("#Accesses").val();
            var __data = _data.split(',');
            $.each(__data, function () {
                var element = "#" + this;
                if (element !== "#") {
                    $("#" + this).prop("checked", true);
                }
            });
        });
    }
</script>