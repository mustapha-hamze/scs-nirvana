@{
    Layout = null;
}

<div class="modal fade" id="user-setting-modal" tabindex="-1" role="dialog" aria-labelledby="userSettingModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="userSettingModalLabel">Manage access</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="userSettingModalBody">
            </div>
            <div class="visually-hidden" role="status" aria-live="polite" id="userSettingStatus"></div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
