@{
    Layout = null;
}
@model Infrastructure.Dto.UserManagementDtos.UserLoginDto
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Sign In - Nirvana CMS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- App css -->
    @await Html.PartialAsync("_CSSAssets")

</head>

<body class="authentication-bg pb-0" data-layout-config='{"darkMode":true}'>

    <div class="auth-fluid" style="background: unset">
        <!--Auth fluid left content -->
        <div class="auth-fluid-form-box">
            <div class="align-items-center d-flex h-100">
                <div class="card-body">

                    <!-- Logo -->
                    <div class="auth-brand text-center text-lg-start">
                        <a class="logo-light d-flex align-items-center justify-content-center justify-content-lg-start gap-2">
                            <span class="d-inline-flex align-items-center justify-content-center rounded"
                                style="width:2.25rem;height:2.25rem;background:#727cf5;color:#fff;font-weight:700;">N</span>
                            <h5 class="text-white m-0">Nirvana CMS</h5>
                        </a>
                    </div>

                    <!-- title-->
                    <h4 class="mt-0">Welcome back</h4>
                    <p class="text-muted mb-4">Sign in to the Nirvana CMS BackOffice to manage content, schemas, and
                        users.</p>

                    <!-- form -->
                    <form method="post">
                        <div class="mb-3">
                            <label for="emailaddress" class="form-label">Email address</label>
                            <input class="form-control" type="email" id="emailaddress" required=""
                                placeholder="Enter your email" asp-for="EmailAddress">
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input class="form-control" type="password" required="" id="password"
                                placeholder="Enter your password" asp-for="Password">
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="checkbox-signin">
                                <label class="form-check-label" asp-for="RememberMe" for="checkbox-signin">Remember
                                    me</label>
                            </div>
                        </div>
                        <div class="d-grid mb-0 text-center">
                            <button class="btn btn-primary" type="submit"><i class="mdi mdi-login"></i> Log In </button>
                        </div>
                    </form>

                    <!-- end form-->

                    <!-- Footer-->
                    <footer class="footer footer-alt">
                        <p class="text-muted">Nirvana CMS &middot; Sonic Core System</p>
                    </footer>

                </div> <!-- end .card-body -->
            </div> <!-- end .align-items-center.d-flex.h-100-->
        </div>
        <!-- end auth-fluid-form-box-->

        <!-- Auth fluid right content -->
        <div class="auth-fluid-right text-center">
            <div class="auth-user-testimonial" style="top: 26rem!important">
                <h2 class="mb-3">Nirvana CMS</h2>
                <p class="lead">
                    One BackOffice for content, categories, schemas, and access &mdash; built for the teams behind
                    Sonic Core System's applications.
                </p>
            </div> <!-- end auth-user-testimonial-->
        </div>
        <!-- end Auth fluid right content -->
    </div>
    <!-- end auth-fluid-->

    <!-- bundle -->
    <script src="/BackOffice/js/vendor.min.js"></script>
    <script src="/BackOffice/js/app.min.js"></script>

</body>

</html>
