@{
    Layout = null;

    var roles = (List<Microsoft.AspNetCore.Identity.IdentityRole>)ViewData["Roles"];
    var applications =
    (List<Application.Contracts.General.ApplicationDto>)ViewData["Applications"];
    var userRoles = (IList<string>)ViewData["UserRoles"];
    var userApplications =
    (List<Application.Contracts.General.UserInApplicationDto>)ViewData["UserApplications"];

    var assignedRoleCount = roles.Count(r => userRoles.Any(ur => ur.Contains(r.Name)));
    var assignedApplicationCount = applications.Count(a => userApplications.Any(ua => ua.ApplicationId == a.Id));
}

<ul class="nav nav-tabs scs-access-tabs" role="tablist" aria-label="Access settings">
    <li class="nav-item" role="presentation">
        <a href="#roles" data-bs-toggle="tab" role="tab" aria-controls="roles" aria-selected="true"
            class="nav-link active" id="roleTabTitle">
            Roles <span class="scs-count">@assignedRoleCount/@roles.Count</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a href="#applications" data-bs-toggle="tab" role="tab" aria-controls="applications" aria-selected="false"
            class="nav-link" id="applicationTabTitle" tabindex="-1">
            Workspaces <span class="scs-count">@assignedApplicationCount/@applications.Count</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a href="#sectors" onclick="sectors('@ViewData["UserId"]')" data-bs-toggle="tab" role="tab"
            aria-controls="sectors" aria-selected="false" class="nav-link" id="sectorTabTitle" tabindex="-1">
            Sectors
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a href="#entities" onclick="entities('@ViewData["UserId"]')" data-bs-toggle="tab" role="tab"
            aria-controls="entities" aria-selected="false" class="nav-link" id="entityTabTitle" tabindex="-1">
            Permissions
        </a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane show active" id="roles" role="tabpanel" aria-labelledby="roleTabTitle" tabindex="0">
        <p class="scs-meta">Roles apply everywhere in the BackOffice, in every workspace. Grant only what this person needs.</p>
        @if (roles.Count == 0)
        {
            <div class="scs-empty-state">
                <i class="mdi mdi-shield-off-outline" aria-hidden="true"></i>
                No roles exist yet. Create one on the Roles page first.
            </div>
        }
        else
        {
            <div class="scs-table-wrap">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th><span class="visually-hidden">Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in roles)
                        {
                            var assigned = userRoles.Any(r => r.Contains(item.Name));
                            <tr class="@(assigned ? "is-selected" : "")">
                                <td>
                                    <span class="scs-assign-name">@item.Name</span>
                                    @if (assigned)
                                    {
                                        <span class="scs-status scs-status--success">Assigned</span>
                                    }
                                    else
                                    {
                                        <span class="scs-status">Not assigned</span>
                                    }
                                </td>
                                <td class="scs-table-actions">
                                    @if (!assigned)
                                    {
                                        <button type="button" onclick="addUserToRole('@ViewData["UserId"]', '@item.Name')"
                                            class="btn btn-sm btn-outline-primary" data-focus-key="role-@item.Name">
                                            Grant <span class="visually-hidden">@item.Name role</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" onclick="removeUserFromRole('@ViewData["UserId"]', '@item.Name')"
                                            class="btn btn-sm btn-outline-danger" data-focus-key="role-@item.Name">
                                            Remove <span class="visually-hidden">@item.Name role</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="tab-pane" id="applications" role="tabpanel" aria-labelledby="applicationTabTitle" tabindex="0">
        <p class="scs-meta">A user can only open the workspaces granted here. Permissions are then set per workspace.</p>
        @if (applications.Count == 0)
        {
            <div class="scs-empty-state">
                <i class="mdi mdi-apps-box" aria-hidden="true"></i>
                No workspaces exist yet.
            </div>
        }
        else
        {
            <div class="scs-table-wrap">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Workspace</th>
                            <th><span class="visually-hidden">Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in applications)
                        {
                            var relation = userApplications.SingleOrDefault(a => a.ApplicationId == item.Id);
                            <tr class="@(relation != null ? "is-selected" : "")">
                                <td>
                                    <span class="scs-assign-name scs-cell-truncate" title="@item.Title">@item.Title</span>
                                    @if (relation != null)
                                    {
                                        <span class="scs-status scs-status--success">Has access</span>
                                    }
                                    else
                                    {
                                        <span class="scs-status">No access</span>
                                    }
                                </td>
                                <td class="scs-table-actions">
                                    @if (relation == null)
                                    {
                                        <button type="button" onclick="addUserToApplication('@ViewData["UserId"]', @item.Id)"
                                            class="btn btn-sm btn-outline-primary" data-app-id="@item.Id"
                                            data-app-title="@item.Title" data-focus-key="app-@item.Id">
                                            Grant access <span class="visually-hidden">to @item.Title</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                            onclick="removeUserFromApplication('@ViewData["UserId"]', @relation.Id)"
                                            class="btn btn-sm btn-outline-danger" data-relation-id="@relation.Id"
                                            data-app-title="@item.Title" data-focus-key="app-@item.Id">
                                            Remove access <span class="visually-hidden">to @item.Title</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="tab-pane" id="sectors" role="tabpanel" aria-labelledby="sectorTabTitle" tabindex="0">
    </div>
    <div class="tab-pane" id="entities" role="tabpanel" aria-labelledby="entityTabTitle" tabindex="0">
    </div>
</div>

<input type="hidden" name="" id="__hidTXTUserId__" value="@ViewData["UserId"]">
