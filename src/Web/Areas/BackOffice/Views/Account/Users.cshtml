@model Application.Contracts.UserManagement.UserDto

@{
    ViewData["Title"] = "Users";
}

@section PageHelper { Find users, approve sign-in, and manage their roles, workspaces, and permissions. }

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#user-modal"
        onclick="newUserForm()">
        <i class="uil uil-user-plus" aria-hidden="true"></i>
        Create user
    </button>
}

<div class="card">
    <div class="card-body">
        <form method="POST" id="frmUserFilters" class="row align-items-start g-3 scs-filter-bar" role="search"
            aria-label="Find users" onsubmit="findUsers(); return false;">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" asp-for="IsAdminUser">User type</label>
                <select class="form-select" asp-for="IsAdminUser">
                    <option value="true">Admin panel users</option>
                    <option value="false">Site users</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-4">
                <label class="form-label" asp-for="Email">Email contains</label>
                <input type="search" class="form-control" asp-for="Email" placeholder="e.g. jane@@ or example.com"
                    aria-describedby="userEmailHelp" autocomplete="off">
                <div class="form-text" id="userEmailHelp">Enter all or part of an email address.</div>
            </div>
            @* No name attribute: filters the loaded rows in the browser and is never posted. *@
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="userApprovalFilter">Approval</label>
                <select class="form-select" id="userApprovalFilter" onchange="filterUsersByApproval()">
                    <option value="">All users</option>
                    <option value="Approved">Approved</option>
                    <option value="Pending approval">Pending approval</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-2 d-grid scs-inline-action">
                <button type="button" class="btn btn-primary" onclick="findUsers()" id="btnUserFilter">
                    <i class="uil uil-filter"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="scs-table-wrap" id="findUsersResultBody" aria-live="polite"></div>
    </div>
</div>

@await Html.PartialAsync("__UserModal")
@await Html.PartialAsync("__UserSettingModal")
@await Html.PartialAsync("__UserAttachmentModal")
@await Html.PartialAsync("__AccountJSFunctions")
@* @await Html.PartialAsync("~/Areas/BackOffice/Views/UserAttachment/__UserAttachmentJSFunctions.cshtml") *@
@section Scripts {
    <script>
        $(document).ready(function () {
            findUsers();
        });
    </script>
}
