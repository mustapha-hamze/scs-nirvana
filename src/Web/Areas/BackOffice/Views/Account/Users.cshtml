@model Application.Contracts.UserManagement.UserDto

@{
    ViewData["Title"] = "Users";
}

@section PageHelper { Manage BackOffice users, approvals, and access. }

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#user-modal"
        onclick="newUserForm()">
        <i class="uil uil-user-plus" aria-hidden="true"></i>
        Create User
    </button>
}

<div class="row">
    <div class="col-md-12 p-0">
        <div class="card">
            <div class="card-body">
                <form method="POST" id="frmUserFilters" class="row align-items-end g-3 scs-filter-bar">
                    <div class="col-md-3">
                        <label class="form-label" asp-for="IsAdminUser">User type</label>
                        <select class="form-control" asp-for="IsAdminUser">
                            <option value="true">Admin Users</option>
                            <option value="false">Users</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Email">Email address</label>
                        <input type="text" class="form-control" asp-for="Email" placeholder="Email">
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-primary" onclick="findUsers()" id="btnUserFilter">
                            <i class="uil uil-filter"></i> Filter
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findUsersResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>

@await Html.PartialAsync("__UserModal")
@await Html.PartialAsync("__UserSettingModal")
@await Html.PartialAsync("__UserAttachmentModal")
@await Html.PartialAsync("__AccountJSFunctions")
@* @await Html.PartialAsync("~/Areas/BackOffice/Views/UserAttachment/__UserAttachmentJSFunctions.cshtml") *@
@section Scripts {
    <script>
        $(document).ready(function () {
            findUsers();
        });
    </script>
}
