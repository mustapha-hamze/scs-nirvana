@{
    Layout = null;
}
@model Infrastructure.Dto.UserManagementDtos.CreateUserDto
<form class="needs-validation row" novalidate id="frmUser" method="POST">
    <input type="hidden" asp-for="UserId" />
    <div asp-validation-summary="All" class="text-danger">
    </div>
    <div class="mb-3 col-md-6">
        <label class="form-label" asp-for="FirstName">First name</label>
        <input type="text" class="form-control" asp-for="FirstName" placeholder="First name" required minlength="4"
            maxlength="64">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
    <div class="mb-3 col-md-6">
        <label class="form-label" asp-for="LastName">Last name</label>
        <input type="text" class="form-control" asp-for="LastName" placeholder="Last name" required minlength="4"
            maxlength="64">
        <div class="invalid-feedback">
            Min length is 4 and max length is 64
        </div>
    </div>
    <div class="mb-3 col-md-6">
        <label class="form-label" asp-for="BirthDate">Birth Date</label>
        <input type="text" class="form-control date" asp-for="BirthDate" data-toggle="date-picker"
            placeholder="Birth Date" data-single-date-picker="true" id="birthdate" required>
        <small>e.g "MM/DD/YYYY"</small>
    </div>
    <div class="mb-3 col-md-6">
        <label class="form-label" asp-for="PhoneNumber">Phone Number</label>
        <input type="text" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');"
            class="form-control" asp-for="PhoneNumber" placeholder="Phone Number" required minlength="11"
            maxlength="16">
        <small>e.g 905553331212</small>
        <div class="invalid-feedback">
            Min length is 11
        </div>
    </div>
    @if (Model == null)
    {
        <div class="mb-3 col-md-6">
            <label class="form-label" asp-for="EmailAddress">Email</label>
            <input type="email" class="form-control" asp-for="EmailAddress" placeholder="Email" required>
            <div class="invalid-feedback">
                Please provide a valid email.
            </div>
        </div>
    }
    else
    {
        <div class="mb-3 col-md-6">
            <label class="form-label" asp-for="EmailAddress">Email</label>
            <input type="email" class="form-control" asp-for="EmailAddress" placeholder="Email" required readonly>
            <div class="invalid-feedback">
                Please provide a valid email.
            </div>
        </div>
    }
    @if (Model == null)
    {
        <div class="mb-3 col-md-3">
            <label class="form-label" asp-for="Password">Password</label>
            <input type="password" class="form-control" asp-for="Password" placeholder="Password" required minlength="8"
                maxlength="64">
            <div class="invalid-feedback">
                Min length is 8 and max length is 64
            </div>
        </div>
        <div class="mb-3 col-md-3">
            <label class="form-label" asp-for="ConfirmPassword">Confirm Password</label>
            <input type="password" class="form-control" asp-for="ConfirmPassword" placeholder="Confirm Password" required>
            <div class="invalid-feedback">
                Min length is 8 and max length is 64
            </div>
        </div>
    }
    <div class="col-md-12 mb-1">
        <div class="alert alert-warning">
            <input type="checkbox" class="form-check-input" asp-for="IsAdminUser">
            <label class="form-check-label" asp-for="IsAdminUser">Is admin panel user ?</label>
        </div>
    </div>
    <div class="col-md-12 mb-1">
        <div class="alert alert-warning">
            <input type="checkbox" class="form-check-input" asp-for="IsApprove">
            <label class="form-check-label" asp-for="IsApprove">Is Approved ?</label>
        </div>
    </div>
    <div class="mb-3 col-md-12">
        <label class="form-label" asp-for="BusinessAddress">Business Address</label>
        <input type="text" class="form-control" asp-for="BusinessAddress" placeholder="Business Address" minlength="16"
            maxlength="256">
        <div class="invalid-feedback">
            Min length is 16 and max length is 256
        </div>
    </div>
    <div class="mb-3 col-md-12">
        <label class="form-label" asp-for="ConfirmPassword">Home Address</label>
        <input type="text" class="form-control" asp-for="HomeAddress" placeholder="Home Address" minlength="16"
            maxlength="256">
        <div class="invalid-feedback">
            Min length is 16 and max length is 256
        </div>
    </div>
</form>
<button class="btn btn-primary mt-2" onclick="saveUserForm()">
    <i class="uil uil-file-check-alt"></i>
    Save User
</button>
<script>
    $('#birthdate').datepicker();
</script>