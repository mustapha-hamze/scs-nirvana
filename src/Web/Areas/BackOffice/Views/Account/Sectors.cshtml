@{
    Layout = null;
    var applications =
    (List<Application.Contracts.General.ApplicationDto>)ViewData["Applications"];
    var userApplications =
    (List<Application.Contracts.General.UserInApplicationDto>)ViewData["UserApplications"];
    var sectors = (List<Application.Contracts.AccessManagement.SectorDto>)ViewData["Sectors"];
}

<div class="p-2">
    <div class="alert alert-info mb-3">
        <div class="row">
            @foreach (var sector in sectors)
            {
                <div class="col-md-3 mt-1">
                    @sector.Title
                </div>
            }
        </div>
    </div>
</div>
