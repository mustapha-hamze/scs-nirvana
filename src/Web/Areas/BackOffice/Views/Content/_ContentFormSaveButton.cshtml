@model ContentFormViewModel
@{
    Layout = null;
}

@if (!Model.IsNew)
{
    @if (Model.CanSaveOrUpdateContent)
    {
        <button type="submit" id="btnSaveContentForm"
            onclick="$('#textAreaDescription').val($('#__descriptionEditor__ .ql-editor').html());$('#textAreaDescriptionFA').val($('#__descriptionEditorFA__ .ql-editor').html())"
            class="btn btn-primary">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Save content
        </button>
    }
    @if (Model.CanChangeActivity)
    {
        @if (Model.IsActive)
        {
            <a href="javascript: void(0);" id="btnDeactiveContent"
                onclick="changeContentActiveMode(@Model.TypeId, @Model.Id, false, 'btnDeactiveContent')"
                class="btn btn-outline-secondary" role="button" title="Take this content off the public site">
                <i class="mdi mdi-eye-off-outline" aria-hidden="true"></i> Deactivate
            </a>
        }
        else
        {
            <a href="javascript: void(0);" id="btnActiveContent"
                onclick="changeContentActiveMode(@Model.TypeId, @Model.Id, true,'btnActiveContent')"
                class="btn btn-outline-success" role="button" title="Make this content visible on the public site">
                <i class="mdi mdi-eye-outline" aria-hidden="true"></i> Activate
            </a>
        }
        @if (Model.ActivationCultureId > 0)
        {
            <a href="javascript: void(0);" id="btnRequestTranslation"
                onclick="requestContentTranslation(@Model.Id, @Model.ActivationCultureId, 'btnRequestTranslation')"
                class="btn btn-outline-primary" role="button" title="Queue a background translation of the current content">
                <i class="mdi mdi-translate" aria-hidden="true"></i> Request translation
            </a>
        }
        else
        {
            <span id="btnRequestTranslation" class="btn btn-outline-secondary disabled" aria-disabled="true">
                Translation unavailable (no activation culture configured)
            </span>
        }
        <span id="contentTranslationState" class="scs-meta" role="status"></span>
    }
}
else
{
    @if (Model.CanSaveOrUpdateContent)
    {
        <button type="submit" id="btnSaveContentForm"
            onclick="$('#textAreaDescription').val($('#__descriptionEditor__ .ql-editor').html());$('#textAreaDescriptionFA').val($('#__descriptionEditorFA__ .ql-editor').html())"
            class="btn btn-primary">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i> Create content
        </button>
    }
}
