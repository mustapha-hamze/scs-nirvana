@model ContentFormViewModel
@{
    Layout = null;
}

@if (!Model.IsNew)
{
    @if (Model.CanSaveOrUpdateContent)
    {
        <button type="submit" id="btnSaveContentForm"
            onclick="$('#textAreaDescription').val($('#__descriptionEditor__ .ql-editor').html());$('#textAreaDescriptionFA').val($('#__descriptionEditorFA__ .ql-editor').html())"
            class="btn btn-primary mt-2">
            <i class="uil uil-file-check-alt"></i> Save Content
        </button>
    }
    @if (Model.CanChangeActivity)
    {
        @if (Model.IsActive)
        {
            <a href="javascript: void(0);" id="btnDeactiveContent"
                onclick="changeContentActiveMode(@Model.TypeId, @Model.Id, false, 'btnDeactiveContent')"
                class="btn btn-success mt-2 ml-3" title="Active — click to deactivate">
                Active (click to deactivate)
            </a>
        }
        else
        {
            <a href="javascript: void(0);" id="btnActiveContent"
                onclick="changeContentActiveMode(@Model.TypeId, @Model.Id, true,'btnActiveContent')"
                class="btn btn-danger mt-2 ml-3" title="Inactive — click to activate">
                Inactive (click to activate)
            </a>
        }
        @if (Model.ActivationCultureId > 0)
        {
            <a href="javascript: void(0);" id="btnRequestTranslation"
                onclick="requestContentTranslation(@Model.Id, @Model.ActivationCultureId, 'btnRequestTranslation')"
                class="btn btn-outline-primary mt-2 ml-3" title="Queue a background translation of the current content">
                Request translation
            </a>
        }
        else
        {
            <span id="btnRequestTranslation" class="btn btn-outline-secondary disabled mt-2 ml-3">
                Translation unavailable (no activation culture configured)
            </span>
        }
        <span id="contentTranslationState" class="ml-2 align-middle"></span>
    }
}
else
{
    @if (Model.CanSaveOrUpdateContent)
    {
        <button type="submit" id="btnSaveContentForm"
            onclick="$('#textAreaDescription').val($('#__descriptionEditor__ .ql-editor').html());$('#textAreaDescriptionFA').val($('#__descriptionEditorFA__ .ql-editor').html())"
            class="btn btn-primary mt-2 ml-3">
            <i class="uil uil-file-check-alt"></i> Save Content
        </button>
    }
}
