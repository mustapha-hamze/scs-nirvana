    function normalizeEditorHtml(html) {
    if (!html) return "";

    const wrapper = document.createElement("div");
    wrapper.innerHTML = html;

    // Step 1: remove pure whitespace paragraphs
    Array.from(wrapper.children).forEach(el => {
    const text = el.textContent
    .replace(/\u00A0/g, "")
    .trim();

    const hasBr = el.querySelector("br");

    if (text === "" && !hasBr) {
    el.remove();
    }
    });

    let nodes = Array.from(wrapper.children);

    const hasMeaningfulText = el =>
    el.textContent.replace(/\u00A0/g, "").trim().length > 0;

    // Step 2: trim leading <p><br></p>
    while (
    nodes.length &&
    !hasMeaningfulText(nodes[0]) &&
    nodes[0].querySelector("br")
    ) {
    nodes[0].remove();
    nodes.shift();
    }

    // Step 3: trim trailing <p><br></p>
    while (
    nodes.length &&
    !hasMeaningfulText(nodes[nodes.length - 1]) &&
    nodes[nodes.length - 1].querySelector("br")
    ) {
    nodes[nodes.length - 1].remove();
    nodes.pop();
    }

    return wrapper.innerHTML.trim();
    }

    function increasePriority(sectionElementId, isFirstItem, priority, currentId, prevId, nextId) {

    if (isFirstItem)
    return;

    const $current = $("#" + sectionElementId);
    const $prev = $current.prev(".row");

    if ($prev.length === 0)
    return;

    // Swap DOM positions
    $current.insertBefore($prev);

    // Swap priority attributes
    const currentPriority = parseInt($current.attr("priority"));
    const prevPriority = parseInt($prev.attr("priority"));

    $current.attr("priority", prevPriority);
    $prev.attr("priority", currentPriority);

    // Optional: visual feedback
    $current.addClass("bg-light");
    setTimeout(() => $current.removeClass("bg-light"), 300);
    }

    function decreasePriority(sectionElementId, isFirstItem, priority, currentId, prevId, nextId) {

    const $current = $("#" + sectionElementId);
    const $next = $current.next(".row");

    if ($next.length === 0)
    return;

    // Swap DOM positions
    $current.insertAfter($next);

    // Swap priority attributes
    const currentPriority = parseInt($current.attr("priority"));
    const nextPriority = parseInt($next.attr("priority"));

    $current.attr("priority", nextPriority);
    $next.attr("priority", currentPriority);

    // Optional: visual feedback
    $current.addClass("bg-light");
    setTimeout(() => $current.removeClass("bg-light"), 300);
    }

    function updateBodyLayout() {
    let sections = $("#sectionPlaceHolder .row");
    let sectionsOrder = "";
    $.each(sections, function () {
    sectionsOrder += $(this).attr("sectionId") + ",";
    });

    setLoadingForBtn('btnUpdateContentBodyLayout');
    $.ajax({
    url: "/BackOffice/Content/UpdateSectionsLayoutOrder",
    contentType: "application/json",
    type: "POST",
    data: JSON.stringify(sectionsOrder)
    }).done(function (data) {
    messageBox("Saved!", "Content body layout order has been updated", "success");
    loadContentBody();
    });
    }

