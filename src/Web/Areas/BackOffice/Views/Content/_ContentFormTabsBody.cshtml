@model ContentFormViewModel
@{
    Layout = null;
}

@if (!Model.IsNew)
{
    @if (Model.CanPreviewBody)
    {
        <div class="tab-pane" id="body" role="tabpanel" aria-labelledby="tab-body" tabindex="0">
</div>
    }
    @if (Model.CanPreviewImages)
    {
        <div class="tab-pane" id="images" role="tabpanel" aria-labelledby="tab-images" tabindex="0">
</div>
    }
    @if (Model.CanPreviewAttachments)
    {
        <div class="tab-pane" id="attachment" role="tabpanel" aria-labelledby="tab-attachment" tabindex="0">
            @* Nothing loads this pane yet; say so instead of showing a blank card. *@
            <div class="scs-empty-state">
                <i class="mdi mdi-paperclip" aria-hidden="true"></i>
                Attachments can't be managed from the editor yet.
            </div>
        </div>
    }
    @if (Model.CanPreviewRelations)
    {
        <div class="tab-pane" id="relations" role="tabpanel" aria-labelledby="tab-relations" tabindex="0">
</div>
    }
    @if (Model.CanPreviewMetadata)
    {
        <div class="tab-pane" id="metadata" role="tabpanel" aria-labelledby="tab-metadata" tabindex="0">
</div>
    }
}
