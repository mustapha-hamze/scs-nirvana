@model ContentFormViewModel
@{
    Layout = null;
}

@if (!Model.IsNew)
{
    @if (Model.CanPreviewBody)
    {
        <div class="tab-pane" id="body">
</div>
    }
    @if (Model.CanPreviewImages)
    {
        <div class="tab-pane" id="images">
</div>
    }
    @if (Model.CanPreviewAttachments)
    {
        <div class="tab-pane" id="attachment">
</div>
    }
    @if (Model.CanPreviewRelations)
    {
        <div class="tab-pane mt-2" id="relations">
</div>
    }
    @if (Model.CanPreviewMetadata)
    {
        <div class="tab-pane" id="metadata">
</div>
    }
}
