@model ContentListViewModel
@{
    Layout = null;
}

<table id="datatable-buttons" class="table table-hover dt-responsive nowrap w-100 scs-content-table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Type</th>
            <th>Status</th>
            <th>Created</th>
            <th class="scs-table-actions">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td class="scs-meta">@item.Id</td>
                <td class="scs-content-title" title="@item.Title">
                    @if (item.Title.Length > 64)
                    {
                        <text>@item.Title.Substring(0, 64) ...</text>
                    }
                    else
                    {
                        <text>@item.Title</text>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.TypeTitle))
                    {
                        <span>@item.TypeTitle</span>
                    }
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="scs-status scs-status--success">Active</span>
                    }
                    else
                    {
                        <span class="scs-status">Inactive</span>
                    }
                </td>
                <td data-order="@item.CreatedDT.ToString("yyyy-MM-ddTHH:mm:ss")">@item.CreatedDT.ToString("yyyy MMM dd, HH:mm")</td>
                <td class="scs-table-actions">
                    @await Html.PartialAsync("_ContentListActionsButton", item)
                </td>
            </tr>
        }
    </tbody>
</table>
