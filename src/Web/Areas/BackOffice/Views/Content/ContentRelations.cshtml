@model ContentRelationsViewModel
@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <h4 class="mt-1 fw-normal">Categories</h3>
    </div>
    <div class="row">
        <div class="col-md-12 mb-2">
            <select class="form-control select2 select2-multiple" data-toggle="select2" multiple="multiple"
                data-placeholder="Choose ..." id="__Select2_Categories__">
                @foreach (var item in Model.Categories)
                {
                    <option value="@item.Id">@item.Title</option>
                }
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h4 class="mt-1 fw-normal">Tags</h3>
    </div>
    <div class="row">
        <div class="col-md-12 mb-2">
            <select class="form-control select2 select2-multiple" data-toggle="select2" multiple="multiple"
                data-placeholder="Choose ..." id="__Select2_Tags__">
                @foreach (var item in Model.Tags)
                {
                    <option value="@item.Id">@item.Title</option>
                }
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h4 class="mt-1 fw-normal">Cultures</h3>
    </div>
    <div class="row">
        <div class="col-md-12 mb-2">
            <select class="form-control select2 select2-multiple" data-toggle="select2" multiple="multiple"
                data-placeholder="Choose ..." id="__Select2_Cultures__">
                @foreach (var item in Model.Cultures)
                {
                    <option value="@item.Id">@item.Title</option>
                }
            </select>
        </div>
    </div>
</div>
@if (Model.CanSaveRelations)
{
    <div class="row mt-2">
    <div class="col-md-12">
        <a href="javascript: void(0);" id="btnSaveContentRelations" onclick="saveContentRelations()"
            class="btn btn-primary"><i class="uil uil-file-share-alt"></i> Save
            Relations</a>
    </div>
</div>
}

<input type="hidden" id="hidCategoriesRelated" value="@Model.CategoriesRelated">
<input type="hidden" id="hidTagsRelated" value="@Model.TagsRelated">
<input type="hidden" id="hidCulturesRelated" value="@Model.CulturesRelated">
