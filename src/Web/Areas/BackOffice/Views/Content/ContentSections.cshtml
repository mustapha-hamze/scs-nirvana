@model ContentSectionsViewModel
@{
    Layout = null;
    var schemas = Model.Schemas;
    var sections = Model.Sections;
}

<input type="hidden" id="hidPriority__ContentSection" value="@Model.Priority" />

<style>
    .muted-text-editor div p {
        margin-bottom: 0rem !important;
    }
</style>

<div class="scs-body-sections" id="sectionPlaceHolder">
    @for (int i = 0; i < sections.Count; i++)
    {
        string sectionElementId = Guid.NewGuid().ToString();

        var item = sections[i];

        var prevId = i > 0 ? sections[i - 1].Id : (int?)null;
        var nextId = i < sections.Count - 1 ? sections[i + 1].Id : (int?)null;

        var isFirstItem = false;
        if (i == 0)
        {
            isFirstItem = true;
            prevId = 0;
        }

        <div class="row scs-body-section" id="sectionDiv-@sectionElementId" priority="@item.Priority"
            sectionId="@item.Id">
            <div class="scs-body-section-toolbar">
                <button type="button"
                    onclick="increasePriority('sectionDiv-@sectionElementId', @isFirstItem.ToString().ToLower(),'@item.Priority','@item.Id', @(prevId ?? 0), @(nextId ?? 0))"
                    class="scs-btn-icon" title="Move section up" aria-label="Move section up">
                    <i class="mdi mdi-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button"
                    onclick="decreasePriority('sectionDiv-@sectionElementId', @isFirstItem.ToString().ToLower(),'@item.Priority','@item.Id', @(prevId ?? 0), @(nextId ?? 0))"
                    class="scs-btn-icon" title="Move section down" aria-label="Move section down">
                    <i class="mdi mdi-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" onclick="removeBodySection('sectionDiv-@sectionElementId')"
                    class="scs-btn-icon is-danger" title="Remove section" aria-label="Remove section">
                    <i class="mdi mdi-delete-outline" aria-hidden="true"></i>
                </button>
            </div>

            @foreach (var element in item.SectionElements)
            {
                string elementRandomId = Guid.NewGuid().ToString();
                switch (element.ElementType)
                {
                    case 1002:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <label for="" class="mb-1">@element.ElementTitle</label>
                            <div id="mutedTextEditor__@elementRandomId" class="muted-text-editor">
                                <button type="button"
                                    onclick="enableTextEditorForEdit('__TextEditor__@elementRandomId', '__TextArea__@elementRandomId', 'mutedTextEditor__@elementRandomId')"
                                    class="scs-btn-icon" title="Edit" aria-label="Edit">
                                    <i class="mdi mdi-pencil-outline" aria-hidden="true"></i>
                                </button>
                                <div>
                                    @Html.Raw(element.EditorText.Replace("<p> </p>", ""))
                                </div>
                            </div>
                            <textarea class="form-control" textAreaSeedId="@elementRandomId" elementId="@element.Id"
                id="__TextArea__@elementRandomId" elementType="1002" style="display: none;">
                                    @Html.Raw(element.EditorText.Replace("<p> </p>", ""))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </textarea>
                            <div id="__TextEditor__@elementRandomId" style=" height: 300px; display: none;">
                                <div class="ql-editor">
                                    @Html.Raw(element.EditorText.Replace("<p> </p>", ""))
                                </div>
                            </div>
                        </div>
                        break;
                    case 1001:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <label for="" class="mb-1">@element.ElementTitle</label>
                            <img src="/Storage/Section/Images/@element.FileNameText" class="w-100" elementId="@element.Id"
                                elementType="1001" imageName="@element.FileNameText" />
                            <input type="file" id="image-upload-@elementRandomId" accept=".jpg, .png, jpeg"
                                onchange="uploadBodyImage('@elementRandomId', @element.Id)" class="form-control">
                            <div id="imageUploaderLoading-@elementRandomId" class="p-3 text-center" style="display: none;">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Uploading</span>
                                </div>
                            </div>
                        </div>
                        break;
                    case 1004:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId" elementId="@element.Id"
                            elementType="1004">
                            <label for="" class="mb-1">@element.ElementTitle</label>
                            <div class="scs-file-tile">
                                <i class="mdi mdi-file-document-outline" aria-hidden="true"></i>
                                <span class="text-truncate" title="@element.FileNameText">@element.FileNameText</span>
                                <button type="button" onclick="removeBodySection('sectionDiv-@sectionElementId')"
                                    class="scs-btn-icon is-danger" title="Remove section" aria-label="Remove section">
                                    <i class="mdi mdi-delete-outline" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        break;
                    case 1003:
                        var images = element.GalleryImages.Split('|');
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <label for="" class="mb-1">@element.ElementTitle</label>
                            <div class="row" id="__imageGallery__@elementRandomId" elementId="@element.Id" elementType="1003">
                                @foreach (var galleryImage in images)
                                {
                                    var galleryImageIdPlaceHolderId = galleryImage.Split('.');
                                    <div class="col-md-2 mb-2" id="@galleryImageIdPlaceHolderId[0]" imageName="@galleryImage">
                                        <img src="/Storage/Section/Gallery/@galleryImage" class="w-100">
                                        <button type="button" onclick="removeImageGallery('@galleryImageIdPlaceHolderId[0]')"
                                            class="btn btn-sm btn-outline-danger w-100 mt-1">Remove image</button>
                                    </div>
                                }
                                <div class="col-md-2">
                                    <button type="button" class="scs-media-add" onclick="openFileUploaderForGallery()">
                                        <i class="mdi mdi-image-plus" aria-hidden="true"></i> Add images
                                    </button>
                                </div>
                            </div>
                        </div>
                        <input id="fileUploaderForGallery" accept=".jpg, .png, jpeg"
                            onchange="uploadBodyImageGallery('@elementRandomId')" type="file" style="display: none;" multiple>
                        break;
                    case 1000:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <label for="" class="mb-1">@element.ElementTitle</label>
                            <input class="form-control" type="text" maxlength="256" elementId="@element.Id" value="@element.TinyText"
                                elementType="1000" />
                        </div>
                        break;
                    case 1005:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <label for="" class="mb-1">@element.ElementTitle</label>
                            <textarea class="form-control" elementId="@element.Id" elementType="1005">@element.EditorText</textarea>
                        </div>
                        break;
                    case 1006:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <h1>
                                @element.TinyText
                                <button type="button"
                                    onclick="enableHTagForEdit('@element.Id','1006','@element.TinyText','@elementRandomId')"
                                    class="scs-btn-icon" title="Edit" aria-label="Edit">
                                    <i class="mdi mdi-pencil-outline" aria-hidden="true"></i>
                                </button>
                            </h1>
                        </div>
                        break;
                    case 1007:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <h2>
                                @element.TinyText
                                <button type="button"
                                    onclick="enableHTagForEdit('@element.Id','1007','@element.TinyText','@elementRandomId')"
                                    class="scs-btn-icon" title="Edit" aria-label="Edit">
                                    <i class="mdi mdi-pencil-outline" aria-hidden="true"></i>
                                </button>
                            </h2>
                        </div>
                        break;
                    case 1008:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <h3>
                                @element.TinyText
                                <button type="button"
                                    onclick="enableHTagForEdit('@element.Id','1008','@element.TinyText','@elementRandomId')"
                                    class="scs-btn-icon" title="Edit" aria-label="Edit">
                                    <i class="mdi mdi-pencil-outline" aria-hidden="true"></i>
                                </button>
                            </h3>
                        </div>
                        break;
                    case 1009:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <h4>
                                @element.TinyText
                                <button type="button"
                                    onclick="enableHTagForEdit('@element.Id','1009','@element.TinyText','@elementRandomId')"
                                    class="scs-btn-icon" title="Edit" aria-label="Edit">
                                    <i class="mdi mdi-pencil-outline" aria-hidden="true"></i>
                                </button>
                            </h4>
                        </div>
                        break;
                    case 1010:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <h5>
                                @element.TinyText
                                <button type="button"
                                    onclick="enableHTagForEdit('@element.Id','1010','@element.TinyText','@elementRandomId')"
                                    class="scs-btn-icon" title="Edit" aria-label="Edit">
                                    <i class="mdi mdi-pencil-outline" aria-hidden="true"></i>
                                </button>
                            </h5>
                        </div>
                        break;
                    case 1011:
                        <div class="col-md-@element.Size mb-1" size="@element.Size" id="@elementRandomId">
                            <h6>
                                @element.TinyText
                                <button type="button"
                                    onclick="enableHTagForEdit('@element.Id','1011','@element.TinyText','@elementRandomId')"
                                    class="scs-btn-icon" title="Edit" aria-label="Edit">
                                    <i class="mdi mdi-pencil-outline" aria-hidden="true"></i>
                                </button>
                            </h6>
                        </div>
                        break;
                }
            }
        </div>
    }
</div>

<p class="scs-empty-state scs-body-empty"><i class="mdi mdi-text-box-plus-outline" aria-hidden="true"></i>This content has no body sections yet. Add one from a schema below.</p>

<h3 class="scs-overline mb-2">Add a section</h3>
<div class="scs-schema-picker" id="divAddSectionPlaceHolder">
    @foreach (SchemaDto item in schemas)
    {
        <button type="button" class="scs-schema-tile" onclick="addContentSection(@item.Id)" title="Add a @item.Title section">
            <img src="/Storage/Schema/Logos/@item.LogoFileName?100001" asp-append-version="true" alt="" onerror="showLogoFallback(this)" />
            <span>@item.Title</span>
        </button>
    }
</div>

@if (Model.CanSaveBody)
{
    <div class="scs-author-actions">
        <button type="button" id="btnSaveContentBody" onclick="saveBody()" class="btn btn-primary"><i
                class="uil uil-file-share-alt" aria-hidden="true"></i> Save body</button>
        <button type="button" id="btnUpdateContentBodyLayout" onclick="updateBodyLayout()" class="btn btn-outline-primary"><i
                class="mdi mdi-swap-vertical" aria-hidden="true"></i> Save section order</button>
    </div>
}

<input id="hidSectionDeleted" type="hidden" />