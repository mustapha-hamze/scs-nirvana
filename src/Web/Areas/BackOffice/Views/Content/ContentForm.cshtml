@using ZXing.QrCode.Internal
@model Application.Contracts.CMS.ContentDto

@{
    var types = (List<Application.Contracts.General.SystemTypeDto>)ViewData["Types"];

    var publishDateTime = Model.PublishDt.ToString("yyyy-MM-dd HH:mm");
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Content" : "Edit Content";
}

@section Styles {
    <link href="/BackOffice/vendor/quill/quill.core.css" rel="stylesheet" type="text/css" />
    <link href="/BackOffice/vendor/quill/quill.snow.css" rel="stylesheet" type="text/css" />
    <style>
        .fa---elements {
            text-align: right !important;
            direction: rtl !important;
        }

        #__descriptionEditorFA__ .ql-editor {
            text-align: right !important;
            direction: rtl !important;
        }
    </style>
}

<div class="scs-page-header mt-2">
    <div>
        <a class="btn btn-outline-primary btn-sm mb-2" onclick="backToContentList()" href="javascript:void(0);">
            <i class="uil uil-corner-up-left"></i>
            Back to List
        </a>
        <h1 class="scs-page-title">@(isNew ? "New Content" : "Edit Content")</h1>
        <p class="scs-page-helper">
            @if (isNew)
            {
                <text>Fill in the general details below, then save to unlock body, images, and relations.</text>
            }
            else
            {
                <text>Content #@Model.Id &middot; update the fields below and save your changes.</text>
            }
        </p>
    </div>
</div>
<div class="row card mt-2 p-2">
    <ul class="nav nav-tabs mb-1">
        <li class="nav-item">
            <a href="#general" data-bs-toggle="tab" aria-expanded="false" class="nav-link active">
                <i class="mdi mdi-home-variant d-md-none d-block"></i>
                <span class="d-none d-md-block">General</span>
            </a>
        </li>
        @await Html.PartialAsync("_ContentFormTabs", Model)
    </ul>
    <div class="tab-content mb-3">
        <div class="tab-pane show active" id="general">
            <form class="needs-validation row" novalidate id="frmContent" method="POST" asp-action="SaveContentForm">
                <input type="hidden" asp-for="Id" id="hidContentId" />
                <input type="hidden" asp-for="ApplicationId" />
                <input type="hidden" asp-for="CreatedDT" />
                <input type="hidden" asp-for="UpdatedDT" />
                <input type="hidden" asp-for="IsDeleted" />
                <input type="hidden" asp-for="IsActive" />
                <div asp-validation-summary="All" class="text-danger">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label" asp-for="TypeId">Type</label>
                    <select id="ddlContentTypeIds__Form" type="text" class="form-control" asp-for="TypeId"
                            placeholder="Title">
                        @* <option value="@ViewData["TypeId"]">Pages</option> *@

                        @if (Model.TypeId.ToString().Contains("100"))
                        {
                            <option value="@Model.TypeId">Page</option>
                        }
                        else
                        {
                            foreach (SystemTypeDto item in types)
                            {
                                <option value="@item.Id">@item.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-8 mb-2">
                    <label class="form-label" asp-for="Title">Title</label>
                    <input type="text" class="form-control" asp-for="Title" placeholder="Title" required minlength="4"
                           maxlength="256">
                    <div class="invalid-feedback">
                        Min length is 4 and max length is 256
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <label class="form-label" asp-for="HeadLine">Head Line</label>
                    <textarea class="form-control" asp-for="HeadLine" maxlength="2048"></textarea>
                    <small class="text-muted">A short, attention-grabbing line shown above the title in listings.</small>
                </div>
                <div class="col-md-12 mb-2">
                    <label class="form-label" asp-for="Abstract">Abstract</label>
                    <textarea class="form-control" asp-for="Abstract" maxlength="2048"></textarea>
                    <small class="text-muted">A brief summary used in previews, cards, and search results.</small>
                </div>
                <div class="col-md-12 mb-2">
                    <label class="form-label" asp-for="Description">Description</label>
                    <textarea class="form-control" asp-for="Description" style="display: none;"
                              id="textAreaDescription"></textarea>
                    <div id="__descriptionEditor__" style="height: 300px;">
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label">Publish Date & Time</label>
                    <input type="text" id="datetime-datepicker-publish" name="PublishDt" asp-for="PublishDt"
                           value="@publishDateTime" class="form-control" placeholder="Date and Time">
                    <small class="text-muted">Content becomes visible on the public site at this date and time.</small>
                </div>
                <div class="col-md-12 d-flex flex-wrap align-items-center gap-2 border-top pt-3 mt-2">
                    @await Html.PartialAsync("_ContentFormSaveButton", Model)
                    @if (Model.Id != 0)
                    {
                        string contentPreviewUrl = ViewData["WebsiteUrl"].ToString() + "/" + Model.Id;
                        <a class="btn btn-info mt-2" href="@contentPreviewUrl" target="_blank" title="Open in a new tab">
                            <i class="mdi mdi-eye-outline"></i>
                            Preview Content
                        </a>
                    }
                </div>
            </form>
        </div>
        @await Html.PartialAsync("_ContentFormTabsBody", Model)
    </div>
</div>
@await Html.PartialAsync("__ContentJSFunctions")
<input type="hidden" name="" id="hidTypeIdContent_Form" value="@ViewData["TypeId"]">
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#ddlContentTypeIds__Form").val($("#hidTypeIdContent_Form").val());

            if ($("#hidTypeIdContent_Form").val().startsWith("100")) {
                $("#sidebarContentManagement").addClass("show");
                $("#liCMSAppPages").addClass("menuitem-active");
                $("#sidebarSecondLevelAppPages").addClass("show");
                $("#thirdLayerMenu_AppPages_" + $("#hidTypeIdContent_Form").val()).addClass("menuitem-active");
                $("#thirdLayerMenu_AppPages_" + $("#hidTypeIdContent_Form").val() + " a").addClass("active");
            } else {
                $("#sidebarContentManagement").addClass("show");
                $("#liCMSContent").addClass("menuitem-active");
                $("#sidebarSecondLevel").addClass("show");
                $("#thirdLayerMenu_Content_" + $("#hidTypeIdContent_Form").val()).addClass("menuitem-active");
                $("#thirdLayerMenu_Content_" + $("#hidTypeIdContent_Form").val() + " a").addClass("active");
            }

            initTextEditor("__descriptionEditor__");
            $('#__descriptionEditor__ .ql-editor').html($('#textAreaDescription').val());

            // FARSI
            @* initTextEditor("__descriptionEditorFA__");
            $('#__descriptionEditorFA__ .ql-editor').html($('#textAreaDescriptionFA').val()); *@

                $("#datetime-datepicker-publish").flatpickr({ enableTime: !0, dateFormat: "Y-m-d H:i" })
        });

        if ($("#hidContentId").val() != "0") {
            // body
            loadContentBody();

            // images
            loadContentImages();

            // relations
            loadContentRelations();

            // metadata
            loadContentMetadata();
        }
    </script>
}