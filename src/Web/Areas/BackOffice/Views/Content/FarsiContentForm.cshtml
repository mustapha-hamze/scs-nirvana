@model FarsiContentFormPageModel

@section Styles {
    <link href="/BackOffice/vendor/quill/quill.core.css" rel="stylesheet" type="text/css" />
    <link href="/BackOffice/vendor/quill/quill.snow.css" rel="stylesheet" type="text/css" />
    <style>
        .fa---elements {
            text-align: right !important;
            direction: rtl !important;
        }

        .fa---elements .ql-editor {
            text-align: right !important;
            direction: rtl !important;
        }

        .source-text {
            white-space: pre-wrap;
            direction: ltr;
            text-align: left;
        }
    </style>
}

<div class="row mt-2">
    <div class="col-md-2 p-0">
        <a class="btn btn-primary w-100" onclick="backToContentList()" href="javascript:void(0);">
            <i class="uil uil-corner-up-left"></i>
            Back
        </a>
    </div>
</div>

@* English source shown read-only (encoded, so HTML tags stay visible for the translator) under each Farsi field. *@
@functions {
    private static string SourceText(string text) => string.IsNullOrEmpty(text) ? "(empty)" : text;
}

<div class="alert alert-secondary mt-2 mb-0" role="status" id="farsiTranslationStatus">
    Translation status: <strong>@(Model.TranslationStatus?.ToString() ?? "Not translated")</strong>
</div>

@if (Model.Seed == Application.UseCases.TranslatorServices.ManualTranslationSeed.Source)
{
    <div class="alert alert-info mt-2" role="alert">
        Farsi content was not found (or was invalid). The fields below have been pre-filled from the English
        content as a starting point.
    </div>
}
else if (Model.Seed == Application.UseCases.TranslatorServices.ManualTranslationSeed.Legacy)
{
    <div class="alert alert-info mt-2" role="alert">
        The fields below were pre-filled from the historical Farsi content. Saving stores them as the current translation.
    </div>
}

<div class="row card mt-2 p-2">
    <ul class="nav nav-tabs mb-1">
        <li class="nav-item">
            <a href="#general" data-bs-toggle="tab" aria-expanded="false" class="nav-link active">
                <i class="mdi mdi-home-variant d-md-none d-block"></i>
                <span class="d-none d-md-block">General</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="#body" data-bs-toggle="tab" aria-expanded="false" class="nav-link">
                <i class="mdi mdi-file-document-outline d-md-none d-block"></i>
                <span class="d-none d-md-block">Body</span>
            </a>
        </li>
        <li class="nav-item">
            <a href="#metadata" data-bs-toggle="tab" aria-expanded="false" class="nav-link">
                <i class="mdi mdi-tag-text-outline d-md-none d-block"></i>
                <span class="d-none d-md-block">Metadata</span>
            </a>
        </li>
    </ul>

    <form id="frmFarsiContent" method="POST" asp-action="SaveFarsiContentForm">
        <input type="hidden" asp-for="Id" id="hidFarsiContentId" />
        <input type="hidden" asp-for="SourceFingerprint" />

        <div class="tab-content mb-3">
            <div class="tab-pane show active" id="general">
                <div class="row">
                    <div class="col-md-12 mb-2">
                        <label class="form-label" asp-for="Title">Title</label>
                        <input type="text" class="form-control fa---elements" dir="rtl" asp-for="Title" maxlength="256">
                        <small class="text-muted d-block source-text">EN: @SourceText(Model.Source.Title)</small>
                    </div>
                    <div class="col-md-12 mb-2">
                        <label class="form-label" asp-for="HeadLine">Head Line</label>
                        <textarea class="form-control fa---elements" dir="rtl" asp-for="HeadLine" maxlength="2048"></textarea>
                        <small class="text-muted d-block source-text">EN: @SourceText(Model.Source.HeadLine)</small>
                    </div>
                    <div class="col-md-12 mb-2">
                        <label class="form-label" asp-for="Abstract">Abstract</label>
                        <textarea class="form-control fa---elements" dir="rtl" asp-for="Abstract" maxlength="2048"></textarea>
                        <small class="text-muted d-block source-text">EN: @SourceText(Model.Source.Abstract)</small>
                    </div>
                    <div class="col-md-12 mb-2">
                        <label class="form-label" asp-for="Description">Description</label>
                        <textarea class="form-control" asp-for="Description" style="display: none;" id="textAreaDescriptionFA"></textarea>
                        <div id="__descriptionEditorFA__" class="fa---elements" style="height: 300px;"></div>
                        <small class="text-muted d-block source-text">EN: @SourceText(Model.Source.Description)</small>
                    </div>
                </div>
            </div>

            <div class="tab-pane" id="body">
                @* Sections/elements come in master order; layout, titles and media are master data. *@
                @if (Model.Sections.Count > 0)
                {
                    @for (int s = 0; s < Model.Sections.Count; s++)
                    {
                        var section = Model.Sections[s];
                        <input type="hidden" asp-for="Sections[s].Id" />
                        <div class="row mb-2 border pt-2 pb-1">
                            @for (int e = 0; e < section.SectionElements.Count; e++)
                            {
                                var source = Model.SourceElements[section.SectionElements[e].Id];
                                <input type="hidden" asp-for="Sections[s].SectionElements[e].Id" />
                                <div class="col-md-@source.Size mb-1">
                                    <label class="mb-1">@source.ElementTitle</label>
                                    @switch (source.ElementType)
                                    {
                                        case 1000:
                                        case 1006:
                                        case 1007:
                                        case 1008:
                                        case 1009:
                                        case 1010:
                                        case 1011:
                                            <input type="text" class="form-control fa---elements" dir="rtl" maxlength="256"
                                                   asp-for="Sections[s].SectionElements[e].TinyText" />
                                            <small class="text-muted d-block source-text">EN: @SourceText(source.TinyText)</small>
                                            break;
                                        case 1002:
                                            var quillId = "__farsiEditor_" + s + "_" + e + "__";
                                            var textAreaId = "__farsiTextArea_" + s + "_" + e + "__";
                                            <textarea class="form-control" style="display: none;" id="@textAreaId"
                                                      asp-for="Sections[s].SectionElements[e].EditorText"></textarea>
                                            <div id="@quillId" class="fa---elements farsi-rich-editor" data-target="@textAreaId"
                                                 style="height: 250px;"></div>
                                            <small class="text-muted d-block source-text">EN: @SourceText(source.EditorText)</small>
                                            break;
                                        case 1005:
                                            <textarea class="form-control fa---elements" dir="rtl"
                                                      asp-for="Sections[s].SectionElements[e].EditorText"></textarea>
                                            <small class="text-muted d-block source-text">EN: @SourceText(source.EditorText)</small>
                                            break;
                                        case 1001:
                                            <img src="/Storage/Section/Images/@source.FileNameText" class="w-100" />
                                            <small class="text-muted d-block">Preserved from source content (not editable here)</small>
                                            break;
                                        case 1003:
                                            var images = (source.GalleryImages ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries);
                                            <div class="row">
                                                @foreach (var galleryImage in images)
                                                {
                                                    <div class="col-md-2 mb-2">
                                                        <img src="/Storage/Section/Gallery/@galleryImage" class="w-100">
                                                    </div>
                                                }
                                            </div>
                                            <small class="text-muted d-block">Preserved from source content (not editable here)</small>
                                            break;
                                        case 1004:
                                            <div class="card text-white bg-success overflow-hidden">
                                                <div class="card-body">
                                                    <div class="toll-free-box text-center">
                                                        <h4><i class="mdi mdi-file-cabinet"></i>@source.FileNameText</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <small class="text-muted d-block">Preserved from source content (not editable here)</small>
                                            break;
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">This content has no body sections.</p>
                }
            </div>

            <div class="tab-pane" id="metadata">
                @if (Model.Metadata != null)
                {
                    var sourceMetadata = Model.Source.Metadata;
                    <div class="row">
                        <input type="hidden" asp-for="Metadata.Id" />
                        <div class="col-md-6 mb-2">
                            <label class="form-label" asp-for="Metadata.Title">Title</label>
                            <input type="text" class="form-control fa---elements" dir="rtl" asp-for="Metadata.Title" maxlength="256">
                            <small class="text-muted d-block source-text">EN: @SourceText(sourceMetadata.Title)</small>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label" asp-for="Metadata.Author">Author</label>
                            <input type="text" class="form-control fa---elements" dir="rtl" asp-for="Metadata.Author" maxlength="128">
                            <small class="text-muted d-block source-text">EN: @SourceText(sourceMetadata.Author)</small>
                        </div>
                        <div class="col-md-12 mb-2">
                            <label class="form-label" asp-for="Metadata.Keywords">Keywords</label>
                            <textarea class="form-control fa---elements" dir="rtl" asp-for="Metadata.Keywords" maxlength="1024"></textarea>
                            <small class="text-muted d-block source-text">EN: @SourceText(sourceMetadata.Keywords)</small>
                        </div>
                        <div class="col-md-12 mb-2">
                            <label class="form-label" asp-for="Metadata.Description">Description</label>
                            <textarea class="form-control fa---elements" dir="rtl" asp-for="Metadata.Description" maxlength="2048"></textarea>
                            <small class="text-muted d-block source-text">EN: @SourceText(sourceMetadata.Description)</small>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">This content has no metadata.</p>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <a href="javascript:void(0);" id="btnSaveFarsiContent" onclick="saveFarsiContent()" class="btn btn-primary">
                    <i class="uil uil-file-share-alt"></i> Save
                </a>
            </div>
        </div>
    </form>
</div>

<script src="/BackOffice/vendor/quill/quill.min.js"></script>
<script src="/BackOffice/js/features/content.js"></script>
<input type="hidden" id="hidTypeIdContent_Form" value="@Model.TypeId">

@section Scripts {
    <script>
        $(document).ready(function () {
            initTextEditor("__descriptionEditorFA__");
            $('#__descriptionEditorFA__ .ql-editor').html($('#textAreaDescriptionFA').val());

            $(".farsi-rich-editor").each(function () {
                var editorId = $(this).attr("id");
                var targetId = $(this).attr("data-target");
                initTextEditor(editorId);
                $("#" + editorId + " .ql-editor").html($("#" + targetId).val());
            });
        });

        function saveFarsiContent() {
            $('#textAreaDescriptionFA').val($('#__descriptionEditorFA__ .ql-editor').html());

            $(".farsi-rich-editor").each(function () {
                var targetId = $(this).attr("data-target");
                $("#" + targetId).val($(this).find(".ql-editor").html());
            });

            setLoadingForBtn('btnSaveFarsiContent');
            $.ajax({
                url: "/BackOffice/Content/SaveFarsiContentForm",
                type: "POST",
                data: $("#frmFarsiContent").serialize()
            }).done(function (data) {
                if (data === "Done") {
                    messageBox("Saved!", "Farsi content has been saved", "success");
                    removeLoadingForBtn('btnSaveFarsiContent', 'saveFarsiContent()', '<i class="uil uil-file-share-alt"></i> Save');
                } else {
                    messageBox("Error!", "Farsi content has not been saved", "error");
                    removeLoadingForBtn('btnSaveFarsiContent', 'saveFarsiContent()', '<i class="uil uil-file-share-alt"></i> Save');
                }
            }).fail(function (xhr) {
                removeLoadingForBtn('btnSaveFarsiContent', 'saveFarsiContent()', '<i class="uil uil-file-share-alt"></i> Save');
                if ((xhr.status === 409 || xhr.status === 400) && xhr.responseJSON && xhr.responseJSON.translationState)
                    messageBox("Not saved", farsiSaveFailure(xhr.responseJSON.translationState, xhr.responseJSON.fields), "warning");
                else if (xhr.status === 404)
                    messageBox("Not saved", "This content no longer exists.", "error");
                else
                    messageBox("Error!", "Farsi content has not been saved", "error");
            });
        }

        // Nothing is written on any of these; the translator's text stays in the form.
        function farsiSaveFailure(state, fields) {
            switch (state) {
                case "InvalidInput":
                    return "Some fields are too long or invalid: " + (fields || []).join(", ") + ". Nothing was saved; correct them and save again.";
                case "SourceChanged":
                    return "The English source changed since this page was loaded. Copy your text, reload, and review it against the current source.";
                case "InvalidStructure":
                    return "The translation doesn't match the current content layout, or its HTML differs from the English source. Reload the page and check the formatted fields.";
                case "TranslationDeleted":
                    return "The Farsi translation for this content was deleted and can't be edited here.";
                case "CultureUnavailable":
                    return "The Farsi culture isn't configured.";
                case "Conflict":
                    return "Someone else saved this translation first. Reload the page and try again.";
                default:
                    return "Farsi content was not saved (" + state + "). Reload the page and try again.";
            }
        }
    </script>
}
