@model ContentIndexViewModel

@section PageHelper { Create, edit, and publish @(Model.TypeTitle.ToLower()) items. }

@section PageActions {
    @await Html.PartialAsync("_CreateContentButton", Model.CanCreateContent)
}

<div class="row">
  <div class="col-xl-12 p-0">
    <div class="card">
      <div class="card-body p-1">
        <div class="table-responsive-sm" id="findContentsResultBody"></div>
        <!-- end table-responsive-->
      </div>
      <!-- end card -->
    </div>
    <!-- end col-->
  </div>
</div>
<script src="/BackOffice/vendor/quill/quill.min.js"></script>
<script src="/BackOffice/js/features/content.js"></script>
<input type="hidden" id="hidContentsTypeId_List" value="@Model.TypeId" />
@section Scripts {
  <script>
    findContents($("#hidContentsTypeId_List").val());
  </script>
}
