@model ContentIndexViewModel

<ul class="scs-breadcrumb">
    <li><a href="/BackOffice/Home/Index">Dashboard</a></li>
    <li>Content Management</li>
    <li>@Model.TypeTitle</li>
</ul>
<div class="scs-page-header">
    <div>
        <h1 class="scs-page-title">@Model.TypeTitle</h1>
        <p class="scs-page-helper">Create, edit, and publish @Model.TypeTitle.ToLower() items.</p>
    </div>
</div>

<div class="row mb-2 mt-2">
  <div class="col-md-12 p-0">
    @await Html.PartialAsync("_CreateContentButton", Model.CanCreateContent)
  </div>
</div>

<div class="row">
  <div class="col-xl-12 p-0">
    <div class="card">
      <div class="card-body p-1">
        <div class="table-responsive-sm" id="findContentsResultBody"></div>
        <!-- end table-responsive-->
      </div>
      <!-- end card -->
    </div>
    <!-- end col-->
  </div>
</div>
<script src="/BackOffice/vendor/quill/quill.min.js"></script>
<script src="/BackOffice/js/features/content.js"></script>
<input type="hidden" id="hidContentsTypeId_List" value="@Model.TypeId" />
@section Scripts {
  <script>
    findContents($("#hidContentsTypeId_List").val());
  </script>
}
