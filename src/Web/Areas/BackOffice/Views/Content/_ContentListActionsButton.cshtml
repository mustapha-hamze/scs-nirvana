@model ContentListItemViewModel

@if (Model.CanEdit)
{
    <a href="/BackOffice/Content/ContentForm/@Model.Id/@Model.TypeId" class="action-icon" title="Edit" aria-label="Edit content">
        <i class="mdi mdi-content-save-edit"></i>
    </a>
}
@if (Model.CanDelete)
{
    <a href="javascript: void(0);" class="action-icon" onclick="deleteContent(@Model.Id)" title="Delete"
       aria-label="Delete content">
        <i class="mdi mdi-delete"></i>
    </a>
}
