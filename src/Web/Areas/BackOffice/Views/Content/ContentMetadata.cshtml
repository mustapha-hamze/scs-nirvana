@model ContentMetadataPageModel
@{
    Layout = null;
}

<div class="scs-author-section">
    <p class="scs-meta mb-3">Search engines and link previews read these fields.</p>
    <form class="needs-validation row g-3" novalidate id="frmContentMetadata" method="POST">
        <input type="hidden" asp-for="Id" id="hidContentMetadataId" />
        <input type="hidden" asp-for="ContentId" />
        <input type="hidden" asp-for="CreatedDT" />
        <input type="hidden" asp-for="UpdatedDT" />
        <input type="hidden" asp-for="IsDeleted" />
        <input type="hidden" asp-for="IsActive" />
        <div class="col-md-6">
            <label class="form-label" asp-for="Title">Title</label>
            <input type="text" asp-for="Title" class="form-control" minlength="2"
                maxlength="64">
            <div class="invalid-feedback">
                Use 2 to 64 characters.
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Author">Author</label>
            <input type="text" class="form-control" asp-for="Author" minlength="2" maxlength="128" />
            <div class="invalid-feedback">
                Use 2 to 128 characters.
            </div>
        </div>
        <div class="col-12">
            <label class="form-label" asp-for="Keywords">Keywords</label>
            <textarea class="form-control" asp-for="Keywords" maxlength="1024" rows="2"></textarea>
        </div>
        <div class="col-12">
            <label class="form-label" asp-for="Description">Description</label>
            <textarea class="form-control" maxlength="2048" asp-for="Description" rows="3"></textarea>
        </div>
    </form>
    @if (Model.CanSaveMetadata)
    {
        <div class="scs-author-actions">
            <button type="button" id="btnSaveContentMetadata" onclick="saveContentMetadata()"
                class="btn btn-primary"><i class="uil uil-file-share-alt" aria-hidden="true"></i> Save metadata</button>
        </div>
    }
</div>
