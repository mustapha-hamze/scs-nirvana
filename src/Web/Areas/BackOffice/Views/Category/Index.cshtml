@model Application.Contracts.CMS.CategoryDto

@{
    ViewData["Title"] = "Categories";
    ViewData["PageHelper"] = "Organize your content into categories and parent/child hierarchies.";
    ViewData["Breadcrumb"] = new BackOfficeCrumb[] { new("Content Management") };
}

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#category-modal"
        onclick="newCategoryForm()">
        <i class="uil uil-plus" aria-hidden="true"></i>
        Create Category
    </button>
}

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findCategoriesResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>

@await Html.PartialAsync("__CategoryModal")
@await Html.PartialAsync("__CategoryJSFunctions")
@section Scripts {
    <script>
        findCategories();
    </script>
}
