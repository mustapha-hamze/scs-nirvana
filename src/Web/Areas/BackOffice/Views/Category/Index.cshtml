@model Application.Contracts.CMS.CategoryDto

@{
    ViewData["Title"] = "Categories";
}

@section PageHelper { Organize your content into categories and parent/child hierarchies. }

@section PageActions {
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#category-modal"
        onclick="newCategoryForm()">
        <i class="uil uil-plus" aria-hidden="true"></i>
        Create Category
    </button>
}

<div class="card">
    <div class="card-body">
        @* List renders here; DataTables supplies search, sorting, paging and export. *@
        <div class="scs-table-wrap" id="findCategoriesResultBody"></div>
    </div>
</div>

@await Html.PartialAsync("__CategoryModal")
@await Html.PartialAsync("__CategoryJSFunctions")
@section Scripts {
    <script>
        findCategories();
    </script>
}
