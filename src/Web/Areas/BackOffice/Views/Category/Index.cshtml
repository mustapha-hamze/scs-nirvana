@model Application.Contracts.CMS.CategoryDto

@{
    ViewData["Title"] = "Categories";
}

<ul class="scs-breadcrumb">
    <li><a href="/BackOffice/Home/Index">Dashboard</a></li>
    <li>Content Management</li>
    <li>Categories</li>
</ul>
<div class="scs-page-header">
    <div>
        <h1 class="scs-page-title">Categories</h1>
        <p class="scs-page-helper">Organize your content into categories and parent/child hierarchies.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#category-modal"
            onclick="newCategoryForm()">
            <i class="uil uil-plus"></i>
            Create Category
        </button>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 p-0">
        <div class="card">
            <div class="card-body p-1">
                <div class="table-responsive-sm" id="findCategoriesResultBody">

                </div> <!-- end table-responsive-->
            </div> <!-- end card -->
        </div><!-- end col-->
    </div>
</div>

@await Html.PartialAsync("__CategoryModal")
@await Html.PartialAsync("__CategoryJSFunctions")
@section Scripts {
    <script>
        findCategories();
    </script>
}