@{
    Layout = null;
}
@model List<Application.Contracts.CMS.CategoryDto>

<div class="table-responsive-sm">
    <table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Parent</th>
                <th>Created</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CategoryDto item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td>
                        @if (item.ParentId != 0)
                        {
                            var parent = Model.Single(c => c.Id == item.ParentId);
                            <text>@parent.Title</text>
                        }
                        else
                        {
                            <text>-----</text>
                        }
                    </td>
                    <td>@item.CreatedDT.ToString("yyyy MMM dd hh:ss")</td>
                    <td>
                        <a href="javascript: void(0);" class="action-icon">
                            <i class="mdi mdi-delete"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>