@{
    Layout = null;
}
@model List<Application.Contracts.CMS.CategoryDto>

@if (Model.Count == 0)
{
    <div class="scs-empty-state">
        <i class="mdi mdi-shape-outline" aria-hidden="true"></i>
        No categories yet. Use Create Category to add the first one.
    </div>
}
else
{
    <table id="datatable-buttons" class="table table-hover dt-responsive nowrap w-100">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Parent</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CategoryDto item in Model)
            {
                <tr>
                    <td class="scs-meta">@item.Id</td>
                    <td class="scs-cell-truncate" title="@item.Title">@item.Title</td>
                    <td>
                        @if (item.ParentId != 0)
                        {
                            var parent = Model.Single(c => c.Id == item.ParentId);
                            <text>@parent.Title</text>
                        }
                        else
                        {
                            <span class="scs-meta">Top level</span>
                        }
                    </td>
                    <td data-order="@item.CreatedDT.ToString("yyyy-MM-ddTHH:mm:ss")">@item.CreatedDT.ToString("yyyy MMM dd, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
