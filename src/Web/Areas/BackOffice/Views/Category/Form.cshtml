@{
    Layout = null;
    var categories = (List<Application.Contracts.CMS.CategoryDto>)ViewData["Categories"];
}

@model Application.Contracts.CMS.CategoryDto

<form class="needs-validation row g-3" novalidate id="frmCategory" method="POST">
    <input type="hidden" asp-for="Id" id="hidCategoryId" />
    <div asp-validation-summary="All" class="alert alert-danger col-12 mb-0" role="alert">
    </div>
    <div class="col-md-6">
        <label class="form-label scs-required" asp-for="Title">Title</label>
        <input type="text" class="form-control" asp-for="Title" required minlength="3" maxlength="64"
            aria-describedby="categoryTitleHelp">
        <div class="form-text" id="categoryTitleHelp">3–64 characters, shown wherever the category is listed.</div>
        <div class="invalid-feedback">Enter a title between 3 and 64 characters.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label" asp-for="ParentId">Parent category</label>
        <select asp-for="ParentId" class="form-control select2" data-toggle="select2" aria-describedby="categoryParentHelp">
            <option value="0">None (top level)</option>
            @foreach (var item in categories)
            {
                <option value="@item.Id">@item.Title</option>
            }
        </select>
        <div class="form-text" id="categoryParentHelp">Choose a parent to nest this category under it.</div>
    </div>
    <div class="col-12">
        <label class="form-label" asp-for="Description">Description</label>
        <textarea class="form-control" asp-for="Description" rows="3"></textarea>
    </div>
    <div class="col-12 scs-author-actions justify-content-end">
        <button type="button" class="btn scs-btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btnSaveCategoryForm" class="btn btn-primary"
            onclick="saveCategoryForm()"><i class="uil uil-file-check-alt" aria-hidden="true"></i> Save category</button>
    </div>
</form>
