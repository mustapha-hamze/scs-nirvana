@inject Application.UseCases.GeneralServices.IApplicationServices applicationServices
@inject Application.UseCases.UserManagementServices.IUserManagementServices userManagementServices
@inject Application.Contracts.Tenancy.ICurrentApplicationContext currentApplicationContext

@{
    ViewData["Title"] = "Dashboard";
    var user = await userManagementServices.GetUserByEmailAddress(User.Identity.Name);
    var app = await applicationServices.GetById(currentApplicationContext.RequireApplicationId());
    var accesses = await userManagementServices.GetUserAccesses(User.Identity.Name, currentApplicationContext.RequireApplicationId());
    if (accesses == string.Empty)
        accesses = "NULL";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool canCMS = isSuperAdmin || accesses.Contains("CMS1000_");
    bool canSCM = isSuperAdmin || accesses.Contains("SCM3000_");

    // Ordered by priority: the first module is the dashboard's primary forward action.
    var modules = new List<(string Name, string Purpose, string Icon, string Tone, string Href, string Action)>();
    if (canCMS)
    {
        modules.Add(("Content", "Write, edit and publish entries for each content type.", "uil-document-layout-right", "primary", "/BackOffice/Category/Index", "Manage content"));
        modules.Add(("Categories", "Group content into categories and nested hierarchies.", "uil-folder", "success", "/BackOffice/Category/Index", "Manage categories"));
        modules.Add(("Schemas", "Define the reusable field structures content sections are built from.", "uil-sitemap", "warning", "/BackOffice/Schema/Index", "Manage schemas"));
    }
    if (canSCM)
    {
        modules.Add(("Sliders", "Curate the image sliders shown on the site.", "uil-images", "accent", "/BackOffice/Slider/Index", "Manage sliders"));
    }
    if (isSuperAdmin)
    {
        modules.Add(("Users & roles", "Invite people, assign roles and review who can sign in.", "uil-users-alt", "info", "/BackOffice/Account/Users", "Manage users"));
        modules.Add(("Settings", "Configure content types, cultures, tags and workspace options.", "uil-cog", "neutral", "/BackOffice/General/ApplicationSetting", "Open settings"));
    }

    var primary = modules.FirstOrDefault();

    // Quiet secondary shortcuts for workspace administration.
    var shortcuts = new List<(string Label, string Icon, string Href)>();
    if (isSuperAdmin)
    {
        shortcuts.Add(("Configure content types", "uil-layer-group", "/BackOffice/General/SystemTypes"));
        shortcuts.Add(("Manage access sectors", "uil-shield-check", "/BackOffice/AccessManagement/Sectors"));
    }
}

@section PageHeading { Welcome back, @user.FirstName }

@section PageHelper { You're working in <strong>@app.Title</strong>. Choose a module to start, or use a quick action. }

@if (primary.Name is null)
{
    <div class="card">
        <div class="card-body scs-empty-state">
            <i class="uil uil-lock-alt" aria-hidden="true"></i>
            <h2 class="card-title mb-1">No modules assigned yet</h2>
            <p class="mb-0">Your account has no module access in @app.Title. Ask a workspace administrator to grant the access you need.</p>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-xl-4 order-xl-2 mb-3">
            <section class="card scs-dash-actions" aria-labelledby="scs-dash-actions-title">
                <div class="card-body">
                    <h2 class="card-title mb-3" id="scs-dash-actions-title">Quick actions</h2>
                    <a href="@primary.Href" class="btn btn-primary w-100 scs-dash-primary">
                        <i class="uil @primary.Icon" aria-hidden="true"></i>
                        <span>@primary.Action</span>
                    </a>
                    @if (shortcuts.Count > 0)
                    {
                        <ul class="scs-dash-shortcuts list-unstyled mb-0 mt-3">
                            @foreach (var shortcut in shortcuts)
                            {
                                <li>
                                    <a href="@shortcut.Href">
                                        <i class="uil @shortcut.Icon" aria-hidden="true"></i>
                                        <span>@shortcut.Label</span>
                                        <i class="uil uil-angle-right ms-auto" aria-hidden="true"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        </div>

        <div class="col-xl-8 order-xl-1">
            <section aria-labelledby="scs-dash-modules-title">
                <h2 class="scs-dash-section-title" id="scs-dash-modules-title">Your workspace</h2>
                <div class="row">
                    @foreach (var module in modules)
                    {
                        <div class="col-sm-6 mb-3">
                            <article class="card scs-dash-card scs-dash-tone-@module.Tone">
                                <div class="card-body">
                                    <span class="scs-dash-icon" aria-hidden="true"><i class="uil @module.Icon"></i></span>
                                    <div class="scs-dash-card-text">
                                        <h3 class="card-title mb-1">@module.Name</h3>
                                        <p class="scs-dash-purpose">@module.Purpose</p>
                                        <a href="@module.Href" class="scs-dash-link stretched-link">
                                            @module.Action <i class="uil uil-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-xl-8 order-xl-3 mb-3">
            <section class="card" aria-labelledby="scs-dash-activity-title">
                <div class="card-body">
                    <h2 class="card-title mb-0" id="scs-dash-activity-title">Recent activity</h2>
                    <div class="scs-empty-state scs-dash-activity-empty">
                        <i class="uil uil-history" aria-hidden="true"></i>
                        <p class="mb-3">Activity history isn't tracked yet, so there's nothing to show here. Your changes are saved in each module as you work.</p>
                        <a href="@primary.Href" class="btn btn-light">@primary.Action</a>
                    </div>
                </div>
            </section>
        </div>
    </div>
}
