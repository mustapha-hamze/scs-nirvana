<script>

    function refreshCacheDB(entity, btnId) {
        setLoadingForBtnFilter(btnId)
        $.ajax({
            url: `/BackOffice/Home/RefereshCacheDb?entity=${entity}`,
            type: "GET",
        }).done(function (data) {
            messageBox('Success', `${entity} cache has been refreshed`, 'success');
            removeLoadingForBtnFilter(btnId, `refreshCacheDB('${entity}', '${btnId}')`);
        });
    }

    function checkFormValidity(form) {
        var flag = false;

        var form = document.getElementById(form);
        form.classList.add('was-validated');

        if (form.checkValidity()) {
            return true;
        }

        return flag;
    }

    function clearModalBody(modalBodyId) {
        modalBodyId = "#" + modalBodyId;
        var html = "";
        html += "<div class=\"p-5 text-center\">";
        html += "<div class=\"spinner-border text-primary\" role=\"status\">";
        html += "<span class=\"visually-hidden\"></span>";
        html += "</div>";
        html += "</div>";
        $(modalBodyId).html(html);
    }

    function uploadFile(file, url, entityId) {
        var upload = new FormData();
        upload.append("File", file);
        upload.append("EntityId", entityId);
        upload.append("Extension", file.type.toLowerCase());

        $.ajax({
            url: url,
            type: "POST",
            contentType: false,
            processData: false,
            data: upload
        }).done(function (data) {
            var _data = data.split('|');
            if (data === "Done") {
                location.reload();
            }
            else {
                return false;
            }
        });
    }

    function setLoadingForBtnFilter(btnId) {
        $("#" + btnId).html("Please wait ...");
        $("#" + btnId).removeAttr("onclick");
    }

    function removeLoadingForBtnFilter(btnId, funcName) {
        $("#" + btnId).html("<i class=\"uil uil-filter\"></i> Filter");
        $("#" + btnId).attr("onclick", funcName);
    }

    function setLoadingForBtn(btnId) {
        $("#" + btnId).html("Please wait ...");
        $("#" + btnId).removeAttr("onclick");
    }

    function removeLoadingForBtn(btnId, funcName, text) {
        $("#" + btnId).html(text);
        $("#" + btnId).attr("onclick", funcName);
    }

    function messageBox(title, text, icon) {
        Swal.fire(
            title,
            text,
            icon
        )
    }
</script>