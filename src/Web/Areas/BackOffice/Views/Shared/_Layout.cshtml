@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")Nirvana CMS | BackOffice</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Nirvana CMS BackOffice — content, schema, and access management for Sonic Core System." name="description" />
    <meta content="Sonic Core System" name="author" />
    <meta name="request-verification-token" content="@Xsrf.GetAndStoreTokens(Context).RequestToken" />

    <!-- App favicon -->
    <link rel="shortcut icon" href="/BackOffice/images/favicon.ico">

    <!-- Select2 css -->
    <link href="/BackOffice/vendor/select2/css/select2.min.css" rel="stylesheet" type="text/css" />

    <!-- Protocol-relative URL would inherit http:// on a plain-http request; pin to https explicitly. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" id="theme-styles">

    <!-- Daterangepicker css -->
    <link rel="stylesheet" href="/BackOffice/vendor/daterangepicker/daterangepicker.css">

    <!-- Bootstrap Touchspin css -->
    <link href="/BackOffice/vendor/bootstrap-touchspin/jquery.bootstrap-touchspin.min.css" rel="stylesheet"
        type="text/css" />

    <!-- Bootstrap Datepicker css -->
    <link href="/BackOffice/vendor/bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet"
        type="text/css" />

    <!-- Bootstrap Timepicker css -->
    <link href="/BackOffice/vendor/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet"
        type="text/css" />

    <!-- Flatpickr Timepicker css -->
    <link href="/BackOffice/vendor/flatpickr/flatpickr.min.css" rel="stylesheet" type="text/css" />

    <!-- Theme Config Js -->
    <script src="/BackOffice/js/hyper-config.js"></script>

    <!-- App css -->
    <link href="/BackOffice/css/app-saas.min.css" rel="stylesheet" type="text/css" id="app-style" />

    <!-- Icons css -->
    <link href="/BackOffice/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- Datatables css -->
    <link href="/BackOffice/vendor/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet"
        type="text/css" />
    <link href="/BackOffice/vendor/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet"
        type="text/css" />
    <link href="/BackOffice/vendor/datatables.net-fixedcolumns-bs5/css/fixedColumns.bootstrap5.min.css" rel="stylesheet"
        type="text/css" />
    <link href="/BackOffice/vendor/datatables.net-fixedheader-bs5/css/fixedHeader.bootstrap5.min.css" rel="stylesheet"
        type="text/css" />
    <link href="/BackOffice/vendor/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet"
        type="text/css" />
    <link href="/BackOffice/vendor/datatables.net-select-bs5/css/select.bootstrap5.min.css" rel="stylesheet"
        type="text/css" />

    <!-- Nirvana CMS design system (docs/backoffice-design-system.md); loaded after the theme CSS, versioned so browsers never keep a stale copy -->
    <link href="/BackOffice/css/scs-admin.css" rel="stylesheet" type="text/css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="scs-backoffice">

    <a class="scs-skip-link" href="#main-content">Skip to content</a>

    <div class="wrapper">

        <!-- ========== Topbar Start ========== -->
        <header class="navbar-custom">
            @await Html.PartialAsync("_Navbar")
        </header>
        <!-- ========== Topbar End ========== -->

        <aside class="leftside-menu" id="leftside-menu" aria-label="Sidebar">
            @await Html.PartialAsync("_SideBar")
        </aside>

        <div class="content-page">
            <div class="content">
            <main class="container-fluid" id="main-content" tabindex="-1">
                @* Shared page header (docs/backoffice-design-system.md#page-header): a page sets
                   ViewData["Title"], optional ViewData["PageHelper"] / ["PageHeading"] /
                   ["Breadcrumb"] (BackOfficeCrumb[]; omitted on the dashboard), and an optional
                   PageActions section for its primary action. *@
                @if (ViewData["Title"] is string pageTitle)
                {
                    var crumbs = ViewData["Breadcrumb"] as BackOfficeCrumb[];
                    <div class="scs-page-header">
                        <div class="scs-page-heading">
                            @if (crumbs is not null)
                            {
                                <nav aria-label="Breadcrumb">
                                    <ol class="breadcrumb scs-breadcrumb">
                                        <li class="breadcrumb-item"><a href="/BackOffice/Home/Index">Dashboard</a></li>
                                        @foreach (var crumb in crumbs)
                                        {
                                            <li class="breadcrumb-item">
                                                @if (crumb.Href is null)
                                                {
                                                    @crumb.Label
                                                }
                                                else
                                                {
                                                    <a href="@crumb.Href">@crumb.Label</a>
                                                }
                                            </li>
                                        }
                                        <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                                    </ol>
                                </nav>
                            }
                            <h1 class="scs-page-title">@(ViewData["PageHeading"] ?? pageTitle)</h1>
                            @if (ViewData["PageHelper"] is string pageHelper)
                            {
                                <p class="scs-page-helper">@pageHelper</p>
                            }
                        </div>
                        @if (IsSectionDefined("PageActions"))
                        {
                            <div class="scs-page-actions">
                                @await RenderSectionAsync("PageActions")
                            </div>
                        }
                    </div>
                }
                @RenderBody()
            </main>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> © SCS
                        </div>
                        <div class="col-md-6">
                        </div>
                    </div>
                </div>
            </footer>

        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>

    <!-- Vendor js -->
    <!-- vendor.min.js bundles its own copy of jQuery, which replaces window.$/window.jQuery
         entirely. Anything that configures $.ajaxSetup must run AFTER this script, or the
         configuration is silently discarded along with the jQuery instance it was set on. -->
    <script src="/BackOffice/js/vendor.min.js"></script>

    <!-- Anti-forgery token is attached to every state-changing AJAX call here so
         individual pages/partials don't need to duplicate this logic. -->
    <script>
        $.ajaxSetup({
            beforeSend: function (xhr, settings) {
                var safeMethods = /^(GET|HEAD|OPTIONS|TRACE)$/i;
                if (!safeMethods.test(settings.type)) {
                    xhr.setRequestHeader(
                        "X-CSRF-TOKEN",
                        $('meta[name="request-verification-token"]').attr("content")
                    );
                }
            }
        });
    </script>

    <!--  Select2 Plugin Js -->
    <script src="/BackOffice/vendor/select2/js/select2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>

    <!-- Daterangepicker js -->
    <script src="/BackOffice/vendor/daterangepicker/moment.min.js"></script>
    <script src="/BackOffice/vendor/daterangepicker/daterangepicker.js"></script>

    <!-- Bootstrap Datepicker Plugin js -->
    <script src="/BackOffice/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>

    <!-- Bootstrap Timepicker Plugin js -->
    <script src="/BackOffice/vendor/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>

    <!-- Bootstrap Touchspin Plugin js -->
    <script src="/BackOffice/vendor/bootstrap-touchspin/jquery.bootstrap-touchspin.min.js"></script>

    <!-- Typehead Plugin js -->
    <script src="/BackOffice/vendor/handlebars/handlebars.min.js"></script>
    <script src="/BackOffice/vendor/typeahead.js/typeahead.bundle.min.js"></script>

    <!-- Flatpickr Timepicker Plugin js -->
    <script src="/BackOffice/vendor/flatpickr/flatpickr.min.js"></script>

    <!-- Datatables js -->
    <script src="/BackOffice/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-fixedcolumns-bs5/js/fixedColumns.bootstrap5.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-fixedheader/js/dataTables.fixedHeader.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-buttons-bs5/js/buttons.bootstrap5.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-buttons/js/buttons.flash.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-buttons/js/buttons.print.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-keytable/js/dataTables.keyTable.min.js"></script>
    <script src="/BackOffice/vendor/datatables.net-select/js/dataTables.select.min.js"></script>

    <!-- App js -->
    <script src="/BackOffice/js/app.min.js"></script>

    <!-- Shell accessibility on top of Hyper's sidebar (app.min.js): current-page and expanded
         state for assistive tech, and focus/Escape handling for the mobile off-canvas menu. -->
    <script>
        (function () {
            var html = document.documentElement;
            var nav = document.querySelector(".side-nav");
            var toggle = document.querySelector(".button-toggle-menu");
            var closeBtn = document.querySelector(".button-close-fullsidebar");

            // Pages that aren't menu links (e.g. the content editor) highlight the list they belong
            // to: the deepest linked breadcrumb below Dashboard.
            var isMenuPage = !!nav.querySelector("a.active");
            if (!isMenuPage) {
                var crumbLinks = document.querySelectorAll(".scs-page-header .breadcrumb a");
                var parentHref = crumbLinks.length > 1 ? crumbLinks[crumbLinks.length - 1].getAttribute("href") : null;
                var parentLink = parentHref && nav.querySelector('a[href="' + parentHref + '"]');
                if (parentLink) {
                    parentLink.classList.add("active");
                    for (var el = parentLink.parentElement; el !== nav; el = el.parentElement) {
                        if (el.classList.contains("collapse")) el.classList.add("show");
                        if (el.tagName === "LI") el.classList.add("menuitem-active");
                    }
                }
            }

            var activeLink = nav.querySelector("a.active");
            // "true" when the highlighted link is the section this page belongs to, not the page itself.
            if (activeLink) activeLink.setAttribute("aria-current", isMenuPage ? "page" : "true");

            // Hyper opens the active branch by adding .show directly; Bootstrap keeps aria-expanded
            // in sync from here on.
            nav.querySelectorAll('[data-bs-toggle="collapse"]').forEach(function (trigger) {
                var target = document.querySelector(trigger.getAttribute("href"));
                trigger.setAttribute("aria-expanded", String(!!target && target.classList.contains("show")));
            });

            function isOffcanvas() { return html.getAttribute("data-sidenav-size") === "full"; }
            function isOpen() {
                return isOffcanvas() ? html.classList.contains("sidebar-enable") : html.getAttribute("data-sidenav-size") !== "condensed";
            }

            var wasOffcanvasOpen = false;
            function syncMenuState() {
                toggle.setAttribute("aria-expanded", String(isOpen()));
                var offcanvasOpen = isOffcanvas() && isOpen();
                if (offcanvasOpen && !wasOffcanvasOpen) closeBtn.focus();
                if (!offcanvasOpen && wasOffcanvasOpen && isOffcanvas()) toggle.focus();
                wasOffcanvasOpen = offcanvasOpen;
            }
            new MutationObserver(syncMenuState).observe(html, { attributes: true, attributeFilter: ["class", "data-sidenav-size"] });
            syncMenuState();

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && isOffcanvas() && isOpen()) closeBtn.click();
            });
        })();
    </script>

    <script>
        function checkFormValidity(form) {
            var flag = false;

            var form = document.getElementById(form);
            form.classList.add('was-validated');

            if (form.checkValidity()) {
                return true;
            }

            return flag;
        }

        function clearModalBody(modalBodyId) {
            modalBodyId = "#" + modalBodyId;
            var html = "";
            html += "<div class=\"p-5 text-center\">";
            html += "<div class=\"spinner-border text-primary\" role=\"status\">";
            html += "<span class=\"visually-hidden\">Loading</span>";
            html += "</div>";
            html += "</div>";
            $(modalBodyId).html(html);
        }

        function uploadFile(file, url, entityId) {
            var upload = new FormData();
            upload.append("File", file);
            upload.append("EntityId", entityId);
            upload.append("Extension", file.type.toLowerCase());

            $.ajax({
                url: url,
                type: "POST",
                contentType: false,
                processData: false,
                data: upload
            }).done(function (data) {
                var _data = data.split('|');
                if (data === "Done") {
                    location.reload();
                }
                else {
                    return false;
                }
            });
        }

        function setLoadingForBtnFilter(btnId) {
            $("#" + btnId).prop("disabled", true).attr("aria-busy", "true").html("<span class=\"spinner-border spinner-border-sm me-1\" aria-hidden=\"true\"></span>Filtering");
        }

        function removeLoadingForBtnFilter(btnId, funcName) {
            $("#" + btnId).prop("disabled", false).removeAttr("aria-busy").html("<i class=\"uil uil-filter\"></i> Filter");
            $("#" + btnId).attr("onclick", funcName);
        }

        function setLoadingForBtn(btnId) {
            $("#" + btnId).prop("disabled", true).attr("aria-busy", "true").html("<span class=\"spinner-border spinner-border-sm me-1\" aria-hidden=\"true\"></span>Saving");
        }

        function removeLoadingForBtn(btnId, funcName, text) {
            $("#" + btnId).prop("disabled", false).removeAttr("aria-busy").html(text);
            $("#" + btnId).attr("onclick", funcName);
        }

        function messageBox(title, text, icon) {
            Swal.fire({
                backdrop: false,
                title,
                text,
                icon
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
