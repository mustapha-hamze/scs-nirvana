@inject Services.GeneralServices.IApplicationServices applicationServices;
@inject Services.UserManagementServices.IUserManagementServices userManagementServices;

@{
    var user = userManagementServices.GetUserByEmailAddress(User.Identity.Name);
    var app = await applicationServices.GetById(user.CurrentApplicationId);
}

<div class="topbar container-fluid">
    <div class="d-flex align-items-center gap-lg-2 gap-1">
        <!-- Sidebar Menu Toggle Button -->
        <button class="button-toggle-menu" title="Toggle sidebar" aria-label="Toggle sidebar">
            <i class="mdi mdi-menu"></i>
        </button>
        <!-- Horizontal Menu Toggle Button -->
        <button class="navbar-toggle" data-bs-toggle="collapse" data-bs-target="#topnav-menu-content"
            title="Toggle navigation" aria-label="Toggle navigation">
            <div class="lines">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </button>
    </div>
    <ul class="topbar-menu d-flex align-items-center gap-3">
        <li class="dropdown">
            <a class="nav-link dropdown-toggle arrow-none nav-user px-2" data-bs-toggle="dropdown" href="#"
                role="button" aria-haspopup="false" aria-expanded="false">
                <span class="account-user-avatar">
                    <img src="/BackOffice/images/users/avatar-1.jpg" alt="user-image" width="32" class="rounded-circle">
                </span>
                <span class="d-lg-flex flex-column gap-1 d-none">
                    <h5 class="my-0">@user.FirstName @user.LastName</h5>
                    <h6 class="my-0 fw-normal">Admin</h6>
                </span>
            </a>
            <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated topbar-dropdown-menu profile-dropdown">
                <div class=" dropdown-header noti-title">
                    <h6 class="text-overflow m-0">Welcome !</h6>
                </div>
                @{
                    var userApps = await applicationServices.GetUserApplications(User.Identity.Name);
                }
                @if (User.IsInRole("SuperAdmin") || userApps.Count > 1)
                {
                    <a href="/BackOffice/Application/SelectApp" class="dropdown-item notify-item">
                        <i class="mdi mdi-refresh me-1"></i>
                        <span>Change Application</span>
                    </a>
                }
                <a href="/Logout" class="dropdown-item notify-item">
                    <i class="mdi mdi-logout me-1"></i>
                    <span>Logout</span>
                </a>
            </div>
        </li>
    </ul>
</div>