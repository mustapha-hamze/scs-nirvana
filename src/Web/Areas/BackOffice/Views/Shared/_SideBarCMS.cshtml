@using Application.UseCases.Utilities.ApplicationConst;

@{
    int appId = currentApplicationContext.RequireApplicationId();
    var accesses = await userManagementServices.GetUserAccesses(User.Identity.Name, appId);
    if (accesses == string.Empty)
        accesses = "NULL";

    var appPages = (await applicationServices.GetApplicationSetting(appId, 6000)).OrderBy(ap => ap.Value);
}
@inject Application.UseCases.GeneralServices.ISystemTypeServices systemTypeServices
@inject Application.UseCases.UserManagementServices.IUserManagementServices userManagementServices
@inject Application.UseCases.GeneralServices.IApplicationServices applicationServices;
@inject Application.Contracts.Tenancy.ICurrentApplicationContext currentApplicationContext;

@if (User.IsInRole("SuperAdmin") || accesses.Contains("CMS1000_"))
{
    <li class="side-nav-item" id="cmsMenuLi">
        <a data-bs-toggle="collapse" href="#sidebarContentManagement" aria-expanded="false"
           aria-controls="sidebarContentManagement" class="side-nav-link">
            <i class="uil-document-layout-right"></i>
            <span> Content Management </span>
            <span class="menu-arrow"></span>
        </a>
        <div class="collapse" id="sidebarContentManagement">
            <ul class="side-nav-second-level">
                @if (User.IsInRole("SuperAdmin") || accesses.Contains("CMS1000_1001"))
                {
                    <li class="side-nav-item" id="liCMSContent">
                        <a data-bs-toggle="collapse" href="#sidebarSecondLevel" aria-expanded="false"
                           aria-controls="sidebarSecondLevel">
                            <span>Content</span>
                            <span class="menu-arrow"></span>
                        </a>
                        <div class="collapse" id="sidebarSecondLevel">
                            <ul class="side-nav-third-level">
                                @{
                                    var contentTypes = await systemTypeServices.GetTypesInTypeGroup(appId, TypeId.Content);
                                }
                                @foreach (var item in contentTypes)
                                {
                                    <li id="thirdLayerMenu_Content_@item.Id">
                                        <a href="/BackOffice/Content/Index/@item.Id">@item.Title</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
                @if (User.IsInRole("SuperAdmin") || accesses.Contains("CMS1000_1004"))
                {
                    <li class="side-nav-item" id="liCMSAppPages">
                        <a data-bs-toggle="collapse" href="#sidebarSecondLevelAppPages" aria-expanded="false"
                           aria-controls="sidebarSecondLevelAppPages">
                            <span>Pages</span>
                            <span class="menu-arrow"></span>
                        </a>
                        <div class="collapse" id="sidebarSecondLevelAppPages">
                            <ul class="side-nav-third-level">
                                @foreach (var item in appPages)
                                {
                                    var pageType = "100" + item.Value;
                                    <li id="thirdLayerMenu_AppPages_@pageType">
                                        <a href="/BackOffice/Content/Index/@pageType">@item.Title</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
                @if (User.IsInRole("SuperAdmin") || accesses.Contains("CMS1000_1002"))
                {
                    <li>
                        <a href="/BackOffice/Category/Index">Category</a>
                    </li>
                }
                @if (User.IsInRole("SuperAdmin") || accesses.Contains("CMS1000_1003"))
                {
                    <li>
                        <a href="/BackOffice/Schema/Index">Schema</a>
                    </li>
                }
            </ul>
        </div>
    </li>
}