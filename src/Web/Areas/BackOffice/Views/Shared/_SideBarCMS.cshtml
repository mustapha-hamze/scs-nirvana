@inject Web.Areas.BackOffice.Presentation.Shell.IBackOfficeShellContext ShellContext

@{
    var shell = await ShellContext.GetSnapshotAsync();
}

@if (shell.Access.CanAnyAccess(Web.Authorization.AccessKeys.Content.Module, Web.Authorization.AccessKeys.Category.Module, Web.Authorization.AccessKeys.Schema.Module))
{
    <li class="side-nav-item" id="cmsMenuLi">
        <a data-bs-toggle="collapse" href="#sidebarContentManagement" aria-expanded="false"
           aria-controls="sidebarContentManagement" class="side-nav-link">
            <i class="uil-document-layout-right"></i>
            <span> Content Management </span>
            <span class="menu-arrow"></span>
        </a>
        <div class="collapse" id="sidebarContentManagement">
            <ul class="side-nav-second-level">
                @if (shell.Access.CanAccess(Web.Authorization.AccessKeys.Content.Module))
                {
                    <li class="side-nav-item" id="liCMSContent">
                        <a data-bs-toggle="collapse" href="#sidebarSecondLevel" aria-expanded="false"
                           aria-controls="sidebarSecondLevel">
                            <span>Content</span>
                            <span class="menu-arrow"></span>
                        </a>
                        <div class="collapse" id="sidebarSecondLevel">
                            <ul class="side-nav-third-level">
                                @foreach (var item in shell.ContentTypes)
                                {
                                    <li id="thirdLayerMenu_Content_@item.Id">
                                        <a href="/BackOffice/Content/Index/@item.Id">@item.Title</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
                @* "Pages" routes to the same ContentController.Index action as "Content" above, gated by
                   the same exact AccessKeys.Content.Module key - see AccessKeys.cs's comment on it. *@
                @if (shell.Access.CanAccess(Web.Authorization.AccessKeys.Content.Module))
                {
                    <li class="side-nav-item" id="liCMSAppPages">
                        <a data-bs-toggle="collapse" href="#sidebarSecondLevelAppPages" aria-expanded="false"
                           aria-controls="sidebarSecondLevelAppPages">
                            <span>Pages</span>
                            <span class="menu-arrow"></span>
                        </a>
                        <div class="collapse" id="sidebarSecondLevelAppPages">
                            <ul class="side-nav-third-level">
                                @foreach (var item in shell.AppPages)
                                {
                                    <li id="thirdLayerMenu_AppPages_@item.PageType">
                                        <a href="/BackOffice/Content/Index/@item.PageType">@item.Title</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                }
                @if (shell.Access.CanAccess(Web.Authorization.AccessKeys.Category.Module))
                {
                    <li id="liCMSCategory">
                        <a href="/BackOffice/Category/Index">Category</a>
                    </li>
                }
                @if (shell.Access.CanAccess(Web.Authorization.AccessKeys.Schema.Module))
                {
                    <li id="liCMSSchema">
                        <a href="/BackOffice/Schema/Index">Schema</a>
                    </li>
                }
            </ul>
        </div>
    </li>
}
