@model List<EntityAccessDto>
@if (Model.Count == 0)
{
    <div class="scs-empty-state">
        <i class="mdi mdi-key-remove" aria-hidden="true"></i>
        This entity has no permissions defined. Add them under Access Management › Accesses.
    </div>
}
else
{
    <fieldset class="scs-permission-list">
        <legend class="visually-hidden">Permissions to grant</legend>
        @foreach (var item in Model)
        {
            <div class="form-check scs-permission-item">
                <input type="checkbox" onchange="setEntityAccessHideInput('@item.Access')" id="@item.Access" access="@item.Access" class="form-check-input" />
                <label class="form-check-label" for="@item.Access"><code class="scs-code">@item.Access</code></label>
            </div>
        }
    </fieldset>
}
