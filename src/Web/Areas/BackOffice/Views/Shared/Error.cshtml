@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card scs-auth-card mt-4">
    <div class="card-body">
        <span class="scs-auth-status scs-auth-status--danger" aria-hidden="true"><i class="uil uil-exclamation-triangle"></i></span>
        <h1 class="scs-auth-title">Something went wrong</h1>
        <p class="scs-auth-lead">We couldn't complete that request. Try again, or go back to the dashboard.</p>

        @if (Model.ShowRequestId)
        {
            <p class="scs-auth-reference">If it keeps happening, contact support and quote reference <code>@Model.RequestId</code>.</p>
        }

        <div class="scs-auth-actions">
            <a class="btn btn-primary" href="/BackOffice/Home/Index">
                <i class="uil uil-arrow-left me-1" aria-hidden="true"></i> Back to dashboard
            </a>
            <a class="btn btn-light" href="/BackOffice/Application/SelectApp">Switch workspace</a>
        </div>
    </div>
</div>
