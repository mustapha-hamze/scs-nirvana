@{
    var accesses = await userManagementServices.GetUserAccesses(User.Identity.Name, currentApplicationContext.CurrentApplicationId ?? 0);
    if (accesses == string.Empty)
        accesses = "NULL";
}
@inject Application.UseCases.UserManagementServices.IUserManagementServices userManagementServices
@inject Application.Contracts.Tenancy.ICurrentApplicationContext currentApplicationContext

@if (User.IsInRole("SuperAdmin") || accesses.Contains("SCM3000_"))
{
    <li class="side-nav-item">
        <a data-bs-toggle="collapse" href="#sidebarSCM" aria-expanded="false" aria-controls="sidebarSCM"
            class="side-nav-link">
            <i class="uil uil-images"></i>
            <span> Media &amp; Modules </span>
            <span class="menu-arrow"></span>
        </a>
        <div class="collapse" id="sidebarSCM">
            <ul class="side-nav-second-level">
                @if (User.IsInRole("SuperAdmin") || accesses.Contains("SCM3000_1001"))
                {
                    <li>
                        <a href="/BackOffice/Slider/Index">Sliders</a>
                    </li>
                }
            </ul>
        </div>
    </li>
}