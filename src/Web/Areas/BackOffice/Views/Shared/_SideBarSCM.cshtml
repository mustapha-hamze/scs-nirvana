@inject Web.Areas.BackOffice.Presentation.Shell.IBackOfficeShellContext ShellContext

@{
    var shell = await ShellContext.GetSnapshotAsync();
}

@if (shell.Access.CanAnyAccess(Web.Authorization.AccessKeys.Slider.Module))
{
    <li class="side-nav-item">
        <a data-bs-toggle="collapse" href="#sidebarSCM" aria-expanded="false" aria-controls="sidebarSCM"
            class="side-nav-link">
            <i class="uil uil-images"></i>
            <span> Media &amp; Modules </span>
            <span class="menu-arrow"></span>
        </a>
        <div class="collapse" id="sidebarSCM">
            <ul class="side-nav-second-level">
                @if (shell.Access.CanAccess(Web.Authorization.AccessKeys.Slider.Module))
                {
                    <li id="liSCMSlider">
                        <a href="/BackOffice/Slider/Index">Sliders</a>
                    </li>
                }
            </ul>
        </div>
    </li>
}
