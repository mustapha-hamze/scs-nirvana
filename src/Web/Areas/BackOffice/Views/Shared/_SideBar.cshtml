@inject Web.Areas.BackOffice.Presentation.Shell.IBackOfficeShellContext ShellContext

@{
    var shell = await ShellContext.GetSnapshotAsync();
}

<!-- LOGO -->
<a href="/BackOffice/Home/Index" class="logo logo-light">
    <span class="logo-lg">
        <img class="h-100" src="/BackOffice/logo-l.png" alt="Sonic Core System">
    </span>
    <span class="logo-sm">
        <img src="/BackOffice/logo-s.png" alt="Sonic Core System">
    </span>
</a>

<!-- Off-canvas close (phones only; Hyper shows it at data-sidenav-size=full) -->
<button type="button" class="button-close-fullsidebar" aria-label="Close menu" aria-controls="leftside-menu">
    <i class="ri-close-fill align-middle" aria-hidden="true"></i>
</button>

<div class="h-100" id="leftside-menu-container" data-simplebar>

    <div class="scs-sidebar-workspace" role="group" aria-labelledby="scs-workspace-label">
        <span class="scs-sidebar-workspace-label" id="scs-workspace-label">Current workspace</span>
        <p class="scs-sidebar-workspace-name" title="@shell.ApplicationTitle">@shell.ApplicationTitle</p>
        @if (shell.IsSuperAdmin || shell.HasMultipleApplications)
        {
            <a class="scs-sidebar-workspace-switch" href="/BackOffice/Application/SelectApp">
                <i class="mdi mdi-swap-horizontal" aria-hidden="true"></i>
                Switch workspace
            </a>
        }
    </div>

    <nav aria-label="Main">
        <ul class="side-nav">

            <li class="side-nav-title">Overview</li>

            <li class="side-nav-item">
                <a href="/BackOffice/Home/Index" class="side-nav-link">
                    <i class="uil uil-monitor" aria-hidden="true"></i>
                    <span> Dashboard </span>
                </a>
            </li>

            @if (shell.Access.CanAnyAccess(Web.Authorization.AccessKeys.Content.Module, Web.Authorization.AccessKeys.Category.Module,
                Web.Authorization.AccessKeys.Schema.Module, Web.Authorization.AccessKeys.Slider.Module))
            {
                <li class="side-nav-title">Content</li>
            }

            @await Html.PartialAsync("_SideBarCMS")

            @await Html.PartialAsync("_SideBarSCM")

            @if (shell.IsSuperAdmin)
            {
                <li class="side-nav-title">Administration</li>
            }
            @await Html.PartialAsync("_SideBarUserManagement")
            @await Html.PartialAsync("_SideBarAdminMenu")
        </ul>
    </nav>

</div>
