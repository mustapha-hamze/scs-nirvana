@{
    Layout = null;
    var sectors = (List<Application.Contracts.AccessManagement.SectorDto>)ViewData["Sectors"];
    var sectorEntities = (List<Application.Contracts.AccessManagement.SectorEntityDto>)ViewData["SectorEntities"];
    var isEdit = Model != null && Model.Id != 0;
}

@model Application.Contracts.AccessManagement.EntityAccessDto
<h2 class="scs-section-title">@(isEdit ? "Edit access" : "Add access")</h2>
@if (isEdit)
{
    <p class="scs-meta">Editing <code class="scs-code">@Model.Access</code>. Users store the keys they were granted, so renaming it here leaves them with the old key; nobody has the new key until you grant it.</p>
}
<form class="needs-validation row g-3 align-items-start" id="frmSaveAccess" novalidate asp-action="SaveSector" method="POST"
    onsubmit="saveAccess(); return false;">
    <input type="hidden" name="Id" asp-for="Id">
    <input type="hidden" name="IsActive" asp-for="IsActive">
    <input type="hidden" name="IsDeleted" asp-for="IsDeleted">
    <input type="hidden" name="Status" asp-for="Status">
    <input type="hidden" name="CreatedDT" asp-for="CreatedDT">
    <input type="hidden" name="UpdatedDT" asp-for="UpdatedDT">
    <div class="col-md-6 col-xl-3">
        <label class="form-label" for="__sectorId__">Sector</label>
        <select class="form-select" id="__sectorId__" onchange="getSectorEntitiesDDL()">
            @foreach (var item in sectors)
            {
                <option value="@item.Id">@item.Title</option>
            }
        </select>
    </div>
    <div class="col-md-6 col-xl-3">
        <label class="form-label scs-required" for="sectorEntitiesDDL">Entity</label>
        <select class="form-select" name="EntityId" asp-for="EntityId" id="sectorEntitiesDDL" required>
            @foreach (var item in sectorEntities)
            {
                <option value="@item.Id">@item.Title</option>
            }
        </select>
        <div class="invalid-feedback">Choose an entity. Add one to this sector first if the list is empty.</div>
    </div>
    <div class="col-md-8 col-xl-4">
        <label class="form-label scs-required" for="Access">Access key</label>
        <input type="text" required name="Access" asp-for="Access" id="Access" class="form-control" maxlength="1024"
            placeholder="e.g. CMS_Pages_Edit" autocomplete="off" aria-describedby="accessKeyHelp"
            data-original="@Model?.Access">
        <div class="form-text" id="accessKeyHelp">The permission key the code checks. Copy it exactly.</div>
        <div class="invalid-feedback">Enter the access key.</div>
    </div>
    <div class="col-md-4 col-xl-2 scs-inline-action d-grid">
        <button type="button" class="btn btn-primary" onclick="saveAccess()">
            <i class="uil uil-file-check-alt" aria-hidden="true"></i>
            @(isEdit ? "Save access" : "Add access")
        </button>
    </div>
    @if (isEdit)
    {
        <div class="col-12">
            <button type="button" class="btn btn-sm scs-btn-quiet" onclick="accessForm()">Cancel editing</button>
        </div>
    }
</form>
<script>
    $("#__sectorId__").val(@ViewData["SectorId"]);
    getSectorEntitiesDDL('edit', @ViewData["EntityId"]);
</script>
