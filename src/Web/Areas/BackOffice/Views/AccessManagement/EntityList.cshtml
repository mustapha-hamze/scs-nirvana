@{
    Layout = null;
}
@model List<Application.Contracts.AccessManagement.SectorEntityDto>

<h5 class="scs-section-title">Entities in this sector <span class="scs-meta fw-normal">(@Model.Count)</span></h5>
@if (Model.Count == 0)
{
    <div class="scs-empty-state">
        <i class="mdi mdi-format-list-bulleted" aria-hidden="true"></i>
        No entities yet. Add the first one above.
    </div>
}
else
{
    <div class="scs-table-wrap">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Access key</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="scs-meta">@item.Id</td>
                        <td class="fw-semibold scs-cell-truncate" title="@item.Title">@item.Title</td>
                        <td><code class="scs-code">@item.AccessKey</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
