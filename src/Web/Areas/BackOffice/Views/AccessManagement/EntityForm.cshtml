@{
    Layout = null;
}

@model Application.Contracts.AccessManagement.SectorEntityDto

<p class="scs-meta mb-3">Sector: <strong class="text-body">@ViewData["SectorTitle"]</strong></p>
<h5 class="scs-section-title">Add entity</h5>

<form class="needs-validation row g-3 align-items-start" id="frmSaveSectorEntity" novalidate asp-action="SaveSectorEntity" method="POST"
    onsubmit="saveEntity(); return false;">
    <input type="hidden" name="Id" asp-for="Id">
    <input type="hidden" name="IsActive" asp-for="IsActive">
    <input type="hidden" name="IsDeleted" asp-for="IsDeleted">
    <input type="hidden" name="Status" asp-for="Status">
    <input type="hidden" name="CreatedDT" asp-for="CreatedDT">
    <input type="hidden" name="UpdatedDT" asp-for="UpdatedDT">
    <input type="hidden" name="SectorId" asp-for="SectorId">
    <div class="col-md-5">
        <label class="form-label scs-required" for="entityTitle">Title</label>
        <input type="text" required name="Title" asp-for="Title" id="entityTitle" class="form-control" maxlength="64"
            placeholder="e.g. Pages">
        <div class="invalid-feedback">Enter an entity title.</div>
    </div>
    <div class="col-md-5">
        <label class="form-label scs-required" for="entityAccessKey">Access key</label>
        <input type="text" required name="AccessKey" asp-for="AccessKey" id="entityAccessKey" class="form-control"
            maxlength="256" placeholder="e.g. CMS_Pages" aria-describedby="entityAccessKeyHelp" autocomplete="off">
        <div class="form-text" id="entityAccessKeyHelp">The key the code checks. Copy it exactly.</div>
        <div class="invalid-feedback">Enter the access key.</div>
    </div>
    <div class="col-md-2 scs-inline-action d-grid">
        <button type="button" class="btn btn-primary" onclick="saveEntity()">
            <i class="uil uil-plus" aria-hidden="true"></i>
            Add
        </button>
    </div>
</form>
