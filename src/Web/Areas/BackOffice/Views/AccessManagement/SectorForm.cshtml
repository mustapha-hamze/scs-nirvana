@{
    Layout = null;
}
@model Application.Contracts.AccessManagement.SectorDto

<form class="needs-validation row g-3 align-items-start" id="frmSaveSector" novalidate asp-action="SaveSector" method="POST"
    onsubmit="saveSector(); return false;">
    <input type="hidden" name="Id" asp-for="Id">
    <input type="hidden" name="IsActive" asp-for="IsActive">
    <input type="hidden" name="IsDeleted" asp-for="IsDeleted">
    <input type="hidden" name="Status" asp-for="Status">
    <input type="hidden" name="CreatedDT" asp-for="CreatedDT">
    <input type="hidden" name="UpdatedDT" asp-for="UpdatedDT">
    <div class="col-md-6 col-xl-4">
        <label class="form-label scs-required" for="sectorTitle">Sector title</label>
        <input type="text" required name="Title" asp-for="Title" id="sectorTitle" class="form-control" maxlength="64"
            placeholder="e.g. Content">
        <div class="invalid-feedback">Enter a sector title.</div>
    </div>
    <div class="col-md-auto scs-inline-action d-grid">
        <button type="button" class="btn btn-primary" onclick="saveSector()">
            <i class="uil uil-plus" aria-hidden="true"></i>
            Add sector
        </button>
    </div>
</form>
