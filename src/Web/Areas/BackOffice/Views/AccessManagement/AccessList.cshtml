@{
    Layout = null;
    var entities =
    (List<Application.Contracts.AccessManagement.SectorEntityDto>)ViewData["SectorEntities"];
}
@model List<Application.Contracts.AccessManagement.EntityAccessDto>

<table id="datatable-buttons" class="table table-striped dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th>Id</th>
            <th>Entity</th>
            <th>Access</th>
            <th>Manage</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Id</td>
                    <td>
                    @entities.SingleOrDefault(e=>e.Id == item.EntityId).Title
                    </td>
                    <td>@item.Access</td>
                    <td>
                        <a href="javascript: void(0);" class="action-icon" onclick="accessEditForm(@item.Id)"
                            title="Edit" aria-label="Edit access">
                            <i class="mdi mdi-content-save-edit"></i>
                        </a>
                    </td>
                </tr>
        }
    </tbody>
</table>