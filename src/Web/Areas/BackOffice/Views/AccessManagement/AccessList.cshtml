@{
    Layout = null;
    var entities =
    (List<Application.Contracts.AccessManagement.SectorEntityDto>)ViewData["SectorEntities"];
}
@model List<Application.Contracts.AccessManagement.EntityAccessDto>

@if (Model.Count == 0)
{
    <div class="scs-empty-state">
        <i class="mdi mdi-key-outline" aria-hidden="true"></i>
        No accesses yet. Add the first one with the form above.
    </div>
}
else
{
    <table id="datatable-buttons" class="table table-hover dt-responsive nowrap w-100">
        <thead>
            <tr>
                <th>Id</th>
                <th>Entity</th>
                <th>Access key</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="scs-meta">@item.Id</td>
                    <td class="fw-semibold">
                        @entities.SingleOrDefault(e=>e.Id == item.EntityId).Title
                    </td>
                    <td><code class="scs-code">@item.Access</code></td>
                    <td class="scs-table-actions">
                        <button type="button" class="btn btn-sm scs-btn-quiet" onclick="accessEditForm(@item.Id)"
                            aria-label="Edit access @item.Access">
                            <i class="mdi mdi-pencil-outline" aria-hidden="true"></i> Edit
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
