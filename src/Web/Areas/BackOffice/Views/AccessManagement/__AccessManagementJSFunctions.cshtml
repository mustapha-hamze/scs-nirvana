<script>
    // Shared DataTables setup for the sector and access lists (actions column is never sortable).
    function initAccessTable(noun) {
        if (!$("#datatable-buttons").length) return;
        $("#datatable-buttons").DataTable({
            lengthChange: !1,
            pageLength: 25,
            buttons: ["copy", "print"],
            order: [[1, "asc"]],
            columnDefs: [{ orderable: false, targets: -1 }],
            language: {
                zeroRecords: "No " + noun + " match your search. Try a shorter or different term.",
                paginate: {
                    previous: "<i class='mdi mdi-chevron-left'>",
                    next: "<i class='mdi mdi-chevron-right'>"
                }
            },
            drawCallback: function () {
                $(".dataTables_paginate > .pagination").addClass("pagination-rounded")
            }
        });
    }

    function sectorForm() {
        clearModalBody("__sectorForm__");
        $.ajax({
            url: '/BackOffice/AccessManagement/SectorForm/',
            type: "GET"
        }).done(function (data) {
            $("#__sectorForm__").html(data);
        });
    }

    function sectorList() {
        clearModalBody("findSectorsResultBody");
        $.ajax({
            url: '/BackOffice/AccessManagement/SectorList',
            type: "GET"
        }).done(function (data) {
            $("#findSectorsResultBody").html(data);
            initAccessTable("sectors");
        });
    }

    function saveSector() {
        if (checkFormValidity('frmSaveSector')) {
            var frmSaveSector = $("#frmSaveSector");
            clearModalBody("__sectorForm__");
            $.ajax({
                type: "POST",
                url: '/BackOffice/AccessManagement/SaveSector',
                data: frmSaveSector.serialize(),
            }).done(function (data) {
                if (data === "Done") {
                    sectorForm();
                    sectorList();
                }
            });
        }
    }

    function entities(sectorId) {
        var sectorTitle = $.trim($('[onclick="entities(' + sectorId + ')"]').closest("tr").find("td").eq(1).text());
        $("#sectorEntityModalLabel").text(sectorTitle ? "Entities in " + sectorTitle : "Sector entities");
        entityForm(sectorId);
        entityList(sectorId);
    }

    function entityForm(sectorId) {
        clearModalBody("entityFormPlaceHolder");
        $.ajax({
            url: '/BackOffice/AccessManagement/EntityForm/' + sectorId,
            type: "GET"
        }).done(function (data) {
            $("#entityFormPlaceHolder").html(data);
        });
    }

    function entityList(sectorId) {
        clearModalBody("entityListPlaceHolder");
        $.ajax({
            url: '/BackOffice/AccessManagement/EntityList/' + sectorId,
            type: "GET"
        }).done(function (data) {
            $("#entityListPlaceHolder").html(data);
        });
    }

    function saveEntity() {
        if (checkFormValidity('frmSaveSectorEntity')) {
            var sectorId = $("#SectorId").val();
            var frmSaveSectorEntity = $("#frmSaveSectorEntity");
            clearModalBody("entityFormPlaceHolder");
            $.ajax({
                type: "POST",
                url: '/BackOffice/AccessManagement/SaveEntity',
                data: frmSaveSectorEntity.serialize(),
            }).done(function (data) {
                if (data === "Done") {
                    entityForm(sectorId);
                    entityList(sectorId);
                }
            });
        }
    }

    function accessForm() {
        clearModalBody("__accessForm__");
        $.ajax({
            url: '/BackOffice/AccessManagement/AccessForm',
            type: "GET"
        }).done(function (data) {
            $("#__accessForm__").html(data);
            getSectorEntitiesDDL();
        });
    }

    function accessEditForm(id) {
        clearModalBody("__accessForm__");
        $.ajax({
            url: '/BackOffice/AccessManagement/AccessForm/' + id,
            type: "GET"
        }).done(function (data) {
            $("#__accessForm__").html(data);
            $("html, body").animate({ scrollTop: 0 }, 500);
            $("#Access").trigger("focus");
            //getSectorEntitiesDDL();
        }).fail(function () {
            $("#__accessForm__").html('<div class="alert alert-danger mb-0" role="alert">Error: this access could not be loaded for editing. ' +
                '<button type="button" class="btn btn-sm scs-btn-quiet" onclick="accessForm()">Back to Add access</button></div>');
        });
    }

    function accessList() {
        clearModalBody("findAccessesResultBody");
        $.ajax({
            url: '/BackOffice/AccessManagement/AccessList',
            type: "GET"
        }).done(function (data) {
            $("#findAccessesResultBody").html(data);
            initAccessTable("accesses");
        });
    }

    function getSectorEntitiesDDL(mode = '', id = 0) {
        $.ajax({
            url: '/BackOffice/AccessManagement/GetSectorEntities/' + $("#__sectorId__").val(),
            type: "GET"
        }).done(function (data) {
            $("#sectorEntitiesDDL").html(data);
            if (mode == 'edit') {
                $("#sectorEntitiesDDL").val(id);
            }
        });
    }

    function saveAccess() {
        if (!checkFormValidity('frmSaveAccess')) {
            $("#frmSaveAccess :invalid").first().trigger("focus");
            return;
        }
        var original = $("#Access").attr("data-original");
        var current = $("#Access").val();
        if (!original || original === current) {
            postAccess();
            return;
        }
        // Renaming an existing key: users keep the old key string they were granted.
        Swal.fire({
            title: "Rename access key?",
            text: "\"" + original + "\" becomes \"" + current + "\". Users who were granted \"" + original + "\" keep that key, and nobody has \"" + current + "\" until you grant it.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "var(--scs-danger-solid)",
            confirmButtonText: "Rename key",
            cancelButtonText: "Cancel",
            focusCancel: true
        }).then((result) => {
            if (result.isConfirmed) postAccess();
        });
    }

    function postAccess() {
        var frmSaveAccess = $("#frmSaveAccess");
        var isEdit = !!$("#Access").attr("data-original");
        $.ajax({
            type: "POST",
            url: '/BackOffice/AccessManagement/SaveAccess',
            data: frmSaveAccess.serialize(),
        }).done(function (data) {
            if (data === "Done") {
                // After an edit go back to adding; after an add keep the sector and entity for the next key.
                if (isEdit) {
                    accessForm();
                } else {
                    frmSaveAccess.removeClass("was-validated");
                    $("#Access").val("").trigger("focus");
                }
                accessList();
            }
        });
    }
</script>