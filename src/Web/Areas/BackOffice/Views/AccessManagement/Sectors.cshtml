@{
    ViewData["Title"] = "Sectors";
}

@section PageHelper { Sectors group the entities of this workspace. Each entity is an area users can be given permissions on. }

<div class="card">
    <div class="card-body">
        <h2 class="scs-section-title">Add sector</h2>
        <div id="__sectorForm__"></div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="scs-table-wrap" id="findSectorsResultBody"></div>
    </div>
</div>

@await Html.PartialAsync("__AccessManagementJSFunctions")
@await Html.PartialAsync("__SectorEntityModal")
@section Scripts {
    <script>
        $(document).ready(function () {
            sectorForm();
            sectorList();
        });
    </script>
}
