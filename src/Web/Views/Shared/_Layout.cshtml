@{
}
<!DOCTYPE html>
<html dir="ltr" lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nirvana CMS | Sonic Core System</title>
    <meta name="description"
        content="Nirvana CMS by Sonic Core System — the content and access management platform powering our digital products." />
    <meta name="author" content="Sonic Core System" />
    <link rel="shortcut icon" href="/BackOffice/images/favicon.ico">

    <style>
        :root {
            --scs-primary: #4a4fb1;
            --scs-primary-dark: #383c8a;
            --scs-ink: #212529;
            --scs-muted: #6c757d;
            --scs-bg: #f7f7fb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--scs-ink);
            background: var(--scs-bg);
            line-height: 1.5;
        }

        a {
            color: inherit;
        }

        .scs-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 1.5rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .scs-brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 700;
            font-size: 1.15rem;
            text-decoration: none;
            color: var(--scs-ink);
        }

        .scs-brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            border-radius: 0.5rem;
            background: var(--scs-primary);
            color: #fff;
            font-size: 1rem;
        }

        .scs-nav-cta {
            display: inline-block;
            padding: 0.5rem 1.1rem;
            border-radius: 0.4rem;
            background: var(--scs-primary);
            color: #fff !important;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .scs-nav-cta:hover {
            background: var(--scs-primary-dark);
        }

        .scs-hero {
            max-width: 1100px;
            margin: 0 auto;
            padding: 4rem 1.5rem 5rem;
            text-align: center;
        }

        .scs-hero h1 {
            font-size: clamp(1.9rem, 4vw, 2.75rem);
            font-weight: 800;
            margin: 0 0 1rem;
        }

        .scs-hero p {
            max-width: 620px;
            margin: 0 auto 2rem;
            color: var(--scs-muted);
            font-size: 1.05rem;
        }

        .scs-cta-row {
            display: flex;
            gap: 0.75rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .scs-btn-primary {
            display: inline-block;
            padding: 0.75rem 1.75rem;
            border-radius: 0.5rem;
            background: var(--scs-primary);
            color: #fff !important;
            text-decoration: none;
            font-weight: 600;
        }

        .scs-btn-primary:hover {
            background: var(--scs-primary-dark);
        }

        .scs-features {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem 4rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.25rem;
        }

        .scs-feature-card {
            background: #fff;
            border: 1px solid #e9e9f2;
            border-radius: 0.75rem;
            padding: 1.5rem;
        }

        .scs-feature-card h3 {
            margin: 0 0 0.5rem;
            font-size: 1.05rem;
        }

        .scs-feature-card p {
            margin: 0;
            color: var(--scs-muted);
            font-size: 0.9rem;
        }

        .scs-footer {
            text-align: center;
            padding: 2rem 1.5rem;
            color: var(--scs-muted);
            font-size: 0.85rem;
        }

        @@media (max-width: 480px) {
            .scs-header {
                flex-direction: column;
                gap: 0.75rem;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
