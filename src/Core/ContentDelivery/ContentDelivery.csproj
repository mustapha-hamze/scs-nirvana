<Project Sdk="Microsoft.NET.Sdk">

  <!-- Public, in-process Content Delivery SDK boundary for CMS websites
       (docs/Content-Delivery-SDK-Implementation-Plan.md). Deliberately references no Core project,
       EF Core, SQL client or JSON library: consumers must not see Domain entities, persistence
       types or raw translation data through it. ContentDeliveryBoundaryTests enforces this. -->
  <PropertyGroup>
    <!-- net9.0 so both net9 and net10 websites can consume it; nothing here needs net10. -->
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Cms.ContentDelivery</AssemblyName>
    <RootNamespace>Cms.ContentDelivery</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Startup binding/validation of the website's tenant configuration. Kept on the 9.0 line so
         a net9 consumer is not forced onto newer Microsoft.Extensions.* assemblies than its
         shared framework ships. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Core.Tests" />
    <InternalsVisibleTo Include="Cms.ContentDelivery.SqlServer.Tests" />
    <!-- The SQL adapter resolves the startup-bound ContentDeliveryTenant. -->
    <InternalsVisibleTo Include="Cms.ContentDelivery.SqlServer" />
  </ItemGroup>

</Project>
