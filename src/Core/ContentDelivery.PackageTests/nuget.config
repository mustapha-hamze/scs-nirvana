<?xml version="1.0" encoding="utf-8"?>
<!-- Cms.ContentDelivery* resolve only from the local feed run.sh packs, into a package folder of
     this fixture's own, so a stale same-version copy in the machine-wide cache is never used. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="obj/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="content-delivery-local" value="obj/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="content-delivery-local">
      <package pattern="Cms.ContentDelivery" />
      <package pattern="Cms.ContentDelivery.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
